{
  "hooks": {
    "after-task-complete": "/home/happy/projects/hpms/hooks/play-completion-sound.sh",
    "after-task-complete-enhanced": "/home/happy/projects/hpms/hooks/play-completion-sound-enhanced.sh",
    "before-task-start": "echo 'Starting new task...'",
    "after-tool-use": "echo 'Tool executed: $TOOL_NAME'",
