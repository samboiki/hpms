#!/usr/bin/env node

/**
 * Claude Hooks - Pre-commit Hook
 * Validates all staged JavaScript/TypeScript files before commit
 */

const { execSync } = require('child_process');
const path = require('path');
const fs = require('fs');
const SyntaxValidator = require('./syntax-validator');

// ANSI colors
const colors = {
  red: '\x1b[31m',
  yellow: '\x1b[33m',
  green: '\x1b[32m',
  blue: '\x1b[34m',
  cyan: '\x1b[36m',
  reset: '\x1b[0m',
  bold: '\x1b[1m'
};

async function main() {
  console.log(`${colors.blue}${colors.bold}🔍 Claude Pre-commit Validation${colors.reset}\n`);

  try {
    // Get staged files
    const stagedFiles = execSync('git diff --cached --name-only --diff-filter=ACM', { encoding: 'utf8' })
      .split('\n')
      .filter(file => file && /\.(js|jsx|ts|tsx)$/.test(file));

    if (stagedFiles.length === 0) {
      console.log(`${colors.green}✓${colors.reset} No JavaScript/TypeScript files to validate`);
      process.exit(0);
    }

    console.log(`Found ${stagedFiles.length} file(s) to validate:\n`);

    // Initialize validator
    const projectRoot = path.resolve(__dirname, '../..');
    const validator = new SyntaxValidator(projectRoot);
    await validator.initialize();

    // Validate each file
    const results = {
      total: stagedFiles.length,
      passed: 0,
      failed: 0,
      warnings: 0,
      errors: []
    };

    for (const file of stagedFiles) {
      const filePath = path.join(projectRoot, file);
      
      // Skip if file doesn't exist (might be deleted)
      if (!fs.existsSync(filePath)) {
        continue;
      }

      // Get staged content (not working directory content)
      let stagedContent;
      try {
        stagedContent = execSync(`git show :${file}`, { encoding: 'utf8' });
      } catch (e) {
        // File might be new, use current content
        stagedContent = fs.readFileSync(filePath, 'utf8');
      }

      const validationResult = await validator.validateFile(filePath, stagedContent);
      
      if (validationResult.valid && validationResult.warnings.length === 0) {
        console.log(`  ${colors.green}✓${colors.reset} ${file}`);
        results.passed++;
      } else if (validationResult.valid) {
        console.log(`  ${colors.yellow}⚠${colors.reset} ${file} (${validationResult.warnings.length} warnings)`);
        results.passed++;
        results.warnings += validationResult.warnings.length;
      } else {
        console.log(`  ${colors.red}✗${colors.reset} ${file} (${validationResult.errors.length} errors)`);
        results.failed++;
        results.errors.push({ file, result: validationResult });
      }
    }

    // Summary
    console.log(`\n${colors.bold}Summary:${colors.reset}`);
    console.log(`  Total files: ${results.total}`);
    console.log(`  ${colors.green}Passed: ${results.passed}${colors.reset}`);
    console.log(`  ${colors.red}Failed: ${results.failed}${colors.reset}`);
    console.log(`  ${colors.yellow}Warnings: ${results.warnings}${colors.reset}`);

    // Show errors if any
    if (results.errors.length > 0) {
      console.log(`\n${colors.red}${colors.bold}Validation Errors:${colors.reset}`);
      
      results.errors.forEach(({ file, result }) => {
        console.log(`\n${colors.bold}${file}:${colors.reset}`);
        result.errors.forEach(error => {
          const location = error.line ? `  Line ${error.line}:${error.column}` : '  ';
          console.log(`${location} ${colors.red}${error.message}${colors.reset}`);
          if (error.rule) {
            console.log(`    Rule: ${error.rule}`);
          }
        });
      });

      // Suggest fixes
      const fixableFiles = results.errors.filter(({ result }) => result.fixable);
      if (fixableFiles.length > 0) {
        console.log(`\n${colors.cyan}💡 Tip:${colors.reset} Some errors can be auto-fixed.`);
        console.log(`Run: ${colors.cyan}npm run lint -- --fix${colors.reset}`);
      }

      // Performance report
      const perfReport = validator.getPerformanceReport();
      console.log(`\n${colors.dim}Performance: ${perfReport.averageTime} avg, ${perfReport.cacheHitRate} cache hit rate${colors.reset}`);

      process.exit(1);
    }

    // Run TypeScript check
    console.log(`\n${colors.blue}Running TypeScript check...${colors.reset}`);
    try {
      execSync('npm run type-check', { stdio: 'inherit' });
      console.log(`${colors.green}✓ TypeScript check passed${colors.reset}`);
    } catch (e) {
      console.log(`${colors.red}✗ TypeScript check failed${colors.reset}`);
      process.exit(1);
    }

    console.log(`\n${colors.green}${colors.bold}✓ All validations passed!${colors.reset}`);
    process.exit(0);

  } catch (error) {
    console.error(`${colors.red}Pre-commit hook failed: ${error.message}${colors.reset}`);
    process.exit(1);
  }
}

// Run the hook
main().catch(error => {
  console.error(`${colors.red}Unexpected error: ${error.message}${colors.reset}`);
  process.exit(1);
});