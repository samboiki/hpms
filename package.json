{
  "name": "healthsys-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names \"🏥DASH,🌐LAND,⚡ADMIN\" --prefix \"[{name}]\" --prefix-colors \"cyan,green,yellow\" \"npm run dev:dashboard\" \"npm run dev:landing\" \"npm run dev:admin\"",
    "dev:clean": "./start-dev-clean.sh",
    "dev:safe": "concurrently --kill-others --names \"🏥DASH,🌐LAND,⚡ADMIN\" --prefix \"[{name}]\" --prefix-colors \"cyan,green,yellow\" \"npm run dev:dashboard\" \"npm run dev:landing:alt\" \"npm run dev:admin:alt\"",
    "dev:dashboard": "vite --host 0.0.0.0 --port 5000 --force",
    "dev:landing": "cd hpms-landing && npm run dev -- --port 3000",
    "dev:landing:alt": "cd hpms-landing && npm run dev -- --port 3001",
    "dev:admin": "cd onehealth && npm run dev -- --port 4000",
    "dev:admin:alt": "cd onehealth && npm run dev -- --port 4001",
    "dev:dashboard-only": "vite --host 0.0.0.0 --port 5000 --force",
    "dev:debug": "vite --host 0.0.0.0 --port 5000 --debug --force",
    "build": "vite build",
    "build:all": "npm run build && cd hpms-landing && npm run build && cd ../onehealth && npm run build",
    "lint": "eslint .",
    "lint:all": "npm run lint && cd hpms-landing && npm run lint && cd ../onehealth && npm run lint",
    "preview": "vite preview",
    "services:status": "node check-services-status.js",
    "kill-ports": "node check-and-kill-ports.js",
    "start": "npm run kill-ports && npm run dev",
    "types:generate": "tsx scripts/supabase-type-sync.ts generate",
    "types:watch": "tsx scripts/supabase-type-sync.ts watch",
    "types:info": "tsx scripts/supabase-type-sync.ts info",
    "db:push": "npx supabase db push",
    "db:types": "npm run types:generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^6.0.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/montserrat": "^5.0.17",
    "@fontsource/poppins": "^5.2.6",
    "@fontsource/rubik": "^5.0.17",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/supabase-js": "^2.39.8",
    "@tanstack/react-query": "^5.28.4",
    "@tanstack/react-query-devtools": "^5.28.4",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.344.0",
    "openai": "^5.5.1",
    "pg": "^8.16.0",
    "react": "^18.3.1",
    "react-calendar": "^6.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.5.2",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.15.3",
    "tailwind-merge": "^2.2.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.18",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "ora": "^8.2.0",
    "postcss": "^8.4.35",
    "supabase": "^2.24.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vercel": "^42.3.0",
    "vite": "^5.4.2",
    "vitest": "^3.2.4"
  }
}
