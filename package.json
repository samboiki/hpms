{
  "name": "healthsys-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File .\\start-windows-dev.ps1",
    "dev:cmd": ".\\start-windows-dev.cmd",
    "dev:clean": "bash ./start-dev-clean.sh",
    "dev:practice": "bash ./start-practice-portal.sh",
    "dev:admin": "bash ./start-onehealth-admin.sh",
    "dev:marketing": "bash ./start-onehealth-marketing.sh",
    "dev:practice-only": "vite --host localhost --port 7000 --force",
    "dev:admin-portal": "cd onehealth-admin && npx vite dev --host localhost --port 8000",
    "dev:admin-only": "cd onehealth && rm -rf .next/cache && npm run dev -- --port 9000",
    "dev:marketing-only": "cd onehealth && rm -rf .next/cache && npm run dev -- --port 9001",
    "dev:concurrent": "concurrently --kill-others --names \"🏥PRACTICE,🎯ADMIN,🌐MARKETING\" --prefix \"[{name}]\" --prefix-colors \"cyan,green,yellow\" \"npm run dev:practice-only\" \"npm run dev:admin-only\" \"npm run dev:marketing-only\"",
    "dev:debug": "vite --host 0.0.0.0 --port 5000 --debug --force",
    "build": "vite build",
    "build:all": "npm run build && cd hpms-landing && npm run build && cd ../onehealth && npm run build",
    "lint": "eslint .",
    "lint:all": "npm run lint && cd hpms-landing && npm run lint && cd ../onehealth && npm run lint",
    "preview": "vite preview",
    "services:status": "node check-services-status.js",
    "kill-ports": "node check-and-kill-ports.js",
    "start": "npm run kill-ports && npm run dev",
    "types:generate": "tsx scripts/supabase-type-sync.ts generate",
    "types:watch": "tsx scripts/supabase-type-sync.ts watch",
    "types:info": "tsx scripts/supabase-type-sync.ts info",
    "db:push": "npx supabase db push",
    "db:types": "npm run types:generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^6.0.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/montserrat": "^5.2.6",
    "@fontsource/poppins": "^5.2.6",
    "@fontsource/rubik": "^5.0.17",
    "@iconify-json/solar": "^1.2.2",
    "@iconify/react": "^6.0.0",
    "@react-pdf/renderer": "^4.3.0",
    "@rollup/rollup-win32-x64-msvc": "^4.22.4",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@types/jspdf": "^1.3.3",
    "@types/lodash": "^4.17.18",
    "@visx/visx": "^3.12.0",
    "chart.js": "^4.4.9",
    "clsx": "^2.1.0",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^2.30.0",
    "express": "^5.1.0",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.344.0",
    "mcp-supabase": "^0.1.0",
    "openai": "^5.5.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-calendar": "^6.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^8.10.1",
