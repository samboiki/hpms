    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^26.1.0",
    "ora": "^8.2.0",
    "postcss": "^8.4.35",
    "prettier": "^3.6.2",
    "recast": "^0.23.11",
    "rollup": "^3.29.4",
    "supabase": "^2.26.9",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vercel": "^42.3.0",
    "vite": "^5.4.20",
    "vitest": "^3.2.4"
  }
}
