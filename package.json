    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.5.2",
    "react-modal": "^3.16.1",
    "react-router-dom": "^6.22.3",
    "react-spring": "^10.0.1",
    "recharts": "^2.15.3",
    "recharts-scale": "^0.4.5",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^2.2.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.2",
