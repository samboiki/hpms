exports[`the owner's medical leave form (sick note) > is drawn as he designed it (snapshot) 1`] = `"<!DOCTYPE html><html><head><meta charset="UTF-8"><style> @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Rubik:wght@400;500;600;700;800;900&display=swap'); * { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: 'Montserrat', sans-serif; font-size: 11px; line-height: 1.5; color: #2c2c2c; background-color: #ffffff; margin: 0; } .leave-container { width: 595px; /* A5 in points */ height: 842px; padding: 20px; margin: 0 auto; background: white; position: relative; } /* Premium Header Section */ .header { padding: 0; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; } .logo-section { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1; } .logo { width: 100px; height: auto; max-height: 50px; border-radius: 6px; object-fit: contain; } .practice-name { font-family: 'Rubik', sans-serif; font-size: 18px; font-weight: 800; color: #5f6578; letter-spacing: -0.2px; } .practice-details { text-align: right; flex: 1; max-width: 250px; font-size: 9px; line-height: 1.6; color: #5a5a5a; font-weight: 400; } /* Certificate Title Section */ .title-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding: 15px 0; border-bottom: 2px solid #d1d5db; } .cert-title { display: flex; align-items: center; gap: 12px; } .cert-icon { width: 32px; height: 32px; background: #11bfaa; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; color: #0e9f8e; } .certificate-title { font-family: 'Rubik', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; color: #5f6578; text-transform: uppercase; } .certificate-number { font-size: 10px; font-weight: 600; color: #666; letter-spacing: 0.3px; } .date-info { display: flex; align-items: center; gap: 15px; font-size: 9px; color: #666; } .date-box { text-align: center; } .date-label { color: #aaa; text-transform: uppercase; margin-bottom: 3px; font-size: 7px; font-weight: 600; letter-spacing: 0.8px; } .date-value { font-weight: 700; color: #2c2c2c; font-size: 10px; } /* PREPARED FOR Section - Exactly Matching Invoice Style */ .patient-section { margin-bottom: 20px; } .section-title { font-size: 14px; font-weight: 700; color: #5f6578; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 0.3px; } .patient-info { display: flex; justify-content: space-between; gap: 25px; } .patient-details { flex: 1; line-height: 1.4; } .patient-name { font-weight: 700; font-size: 12px; color: #1a1a1a; margin-bottom: 3px; } .patient-contact { color: #666; margin-bottom: 2px; font-size: 9px; } /* Certification Section - Clean Design */ .certification-section { margin-bottom: 20px; } .certification-header { font-size: 14px; font-weight: 700; color: #5f6578; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 0.3px; } .certification-text { font-size: 11px; line-height: 1.6; color: #333; margin-bottom: 12px; } .diagnosis-info { margin-top: 8px; } .diagnosis-label { font-size: 9px; color: #666; text-transform: uppercase; margin-bottom: 2px; } .diagnosis-value { font-weight: 600; color: #1a1a1a; font-size: 11px; } /* Leave Period Section - Compact with Grey Background */ .leave-period-section { margin-bottom: 20px; } .leave-period-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; background: #f8f9fa; padding: 12px; border-radius: 6px; border: 1px solid #e9ecef; } .period-item { text-align: center; } .period-label { font-size: 8px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px; } .period-value { font-weight: 700; font-size: 13px; color: #1a1a1a; } .period-date { font-size: 9px; color: #666; margin-top: 1px; } /* Removed fitness status styles */ /* Restrictions Section */ .restrictions-section { margin-bottom: 20px; padding: 12px 15px; background: #fff7ed; border-radius: 6px; border: 1px solid #fed7aa; } .restrictions-title { font-size: 10px; font-weight: 600; color: #ea580c; margin: 0 0 6px 0; text-transform: uppercase; } .restrictions-text { font-size: 10px; line-height: 1.4; color: #7c2d12; } /* Footer Section */ .footer { position: absolute; bottom: 20px; left: 20px; right: 20px; } .signature-section { display: flex; justify-content: space-between; gap: 40px; margin-bottom: 20px; } .signature-box { flex: 1; text-align: center; } .signature-line { border-bottom: 1px solid #999; height: 40px; margin-bottom: 5px; } .signature-label { font-size: 9px; color: #666; line-height: 1.3; } .footer-info { text-align: center; padding-top: 15px; border-top: 1px solid #e5e7eb; } .footer-text { font-size: 8px; color: #6b7280; line-height: 1.5; } .footer-brand { margin-top: 8px; font-size: 7px; color: #9ca3af; border-top: 1px solid #f3f4f6; padding-top: 6px; } /* Removed watermark styles */ </style></head><body><div class="leave-container"><div class="header"><div class="logo-section"><img src="https://example.test/logo.png" alt="Practice Logo" class="logo"><div class="practice-name">Example Practice</div></div><div class="practice-details"><div>12 Example Street</div><div>Windhoek, Namibia 9000</div><div>Tel: +264 61 000 0000</div><div>Email: reception@example.test</div><div>Practice No: 0000000</div></div></div><div class="title-section"><div class="cert-title"><span class="certificate-title">MEDICAL CERTIFICATE</span><span class="certificate-number">#LF-000045</span></div><div class="date-info"><div class="date-box"><div class="date-label">DATE ISSUED</div><div class="date-value">15 Oct 2026</div></div></div></div><div class="patient-section"><h3 class="section-title">PREPARED FOR</h3><div class="patient-info"><div class="patient-details"><div class="patient-name">Anna Example</div><div class="patient-contact">+264 81 000 0001</div><div class="patient-contact">anna@example.test</div><div class="patient-contact">7 Sample Road</div></div><div class="patient-details" style="text-align: right;"><div class="patient-name">EMF</div><div class="patient-contact">Scheme: Example Plus</div><div class="patient-contact">Member: EX1234567</div></div></div></div><div class="certification-section"><h3 class="certification-header">MEDICAL JUSTIFICATION FOR ABSENCE</h3><div class="certification-text"> This letter serves to certify that the patient, <strong>Anna Example</strong>, was examined and treated at our facility on <strong>07 October 2026</strong>. <br><br> Based on my medical assessment, the patient was found to be medically unfit for duty. <br><br> Therefore, I have recommended <strong>three</strong> (<strong>3</strong>) days of sick leave, effective for the period of <strong>07 October 2026</strong>. The patient is expected to be fit to resume normal duties from <strong>10 October 2026</strong>. </div><div class="diagnosis-info"><div class="diagnosis-label">Medical Findings</div><div class="diagnosis-value"> Acute upper respiratory infection (ICD-10: J06.9) </div></div></div><div class="leave-period-section"><h3 class="section-title">MEDICAL LEAVE PERIOD</h3><div class="leave-period-grid"><div class="period-item"><div class="period-label">From Date</div><div class="period-value">07 Oct</div><div class="period-date">2026</div></div><div class="period-item"><div class="period-label">To Date</div><div class="period-value">09 Oct</div><div class="period-date">2026</div></div><div class="period-item"><div class="period-label">Total Days</div><div class="period-value">3</div><div class="period-date">days</div></div></div></div><div class="footer"><div class="signature-section"><div class="signature-box"><div class="signature-line"></div><div class="signature-label">Patient Signature</div></div><div class="signature-box"><div class="signature-line" style="display: flex; align-items: center; justify-content: center;"></div><div class="signature-label"> Dr A Example<br> Prescribing Physician </div></div></div><div class="footer-info"><p class="footer-text"> This certificate is issued in accordance with medical examination findings.<br> For verification: +264 61 000 0000 • reception@example.test </p><div class="footer-brand"> Certificate generated by <strong>OneHealth Systems</strong> • www.onehealthsystems.com • © 2024 </div></div></div></div></body></html>"`;

exports[`the owner's printed prescription > is drawn as he designed it (snapshot) 1`] = `"<!DOCTYPE html><html><head><meta charset="UTF-8"><style> @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Rubik:wght@400;500;600;700;800;900&display=swap'); * { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: 'Montserrat', sans-serif; font-size: 11px; line-height: 1.5; color: #2c2c2c; background-color: #ffffff; margin: 0; } .prescription-container { width: 595px; /* A5 in points */ height: 842px; padding: 20px; margin: 0 auto; background: white; position: relative; } /* Premium Header Section */ .header { padding: 0; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; } .logo-section { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; flex: 1; } .logo { width: 100px; height: auto; max-height: 50px; border-radius: 6px; object-fit: contain; } .practice-name { font-family: 'Rubik', sans-serif; font-size: 18px; font-weight: 800; color: #5f6578; letter-spacing: -0.2px; } .practice-details { text-align: right; flex: 1; max-width: 250px; font-size: 9px; line-height: 1.6; color: #5a5a5a; font-weight: 400; } /* Prescription Title Section */ .title-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding: 15px 0; border-bottom: 2px solid #d1d5db; } .rx-title { display: flex; align-items: center; gap: 12px; } .rx-symbol { font-size: 28px; font-weight: 700; color: #0e9f8e; } .prescription-title { font-family: 'Rubik', sans-serif; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; color: #5f6578; } .prescription-number { font-size: 10px; font-weight: 600; color: #666; letter-spacing: 0.3px; } .date-info { display: flex; align-items: center; gap: 15px; font-size: 9px; color: #666; } .date-box { text-align: center; } .date-label { color: #aaa; text-transform: uppercase; margin-bottom: 3px; font-size: 7px; font-weight: 600; letter-spacing: 0.8px; } .date-value { font-weight: 700; color: #2c2c2c; font-size: 10px; } /* Patient Info Section */ .patient-section { margin-bottom: 20px; } .section-title { font-size: 12px; font-weight: 700; color: #0e9f8e; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 0.3px; } .patient-info { display: flex; justify-content: space-between; gap: 25px; } .patient-details { flex: 1; line-height: 1.4; } .patient-name { font-weight: 700; font-size: 12px; color: #1a1a1a; margin-bottom: 3px; } .patient-detail-line { color: #666; margin-bottom: 2px; font-size: 9px; } /* Medications Section */ .medications-section { margin-bottom: 30px; } .medications-title { font-size: 14px; font-weight: 700; color: #5f6578; margin: 0 0 12px 0; padding-bottom: 8px; border-bottom: 1px solid #d1d5db; text-transform: uppercase; letter-spacing: 0.3px; } .medications-table { width: 100%; border-collapse: collapse; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; } .medications-table thead { background: #5f6578; color: white; } .medications-table th { padding: 8px; text-align: left; font-weight: 600; font-size: 10px; border-right: 1px solid rgba(255,255,255,0.3); text-transform: uppercase; } .medications-table th:last-child { border-right: none; } .medications-table tbody tr { border-bottom: 1px solid #f3f4f6; } .medications-table tbody tr:nth-child(even) { background: #f9fafb; } .medications-table td { padding: 6px 8px; border-right: 1px solid #e5e7eb; font-size: 10px; vertical-align: middle; } .medications-table td:last-child { border-right: none; } .medication-name { font-weight: 600; color: #1f2937; } /* Diagnosis Section */ .diagnosis-section { margin-bottom: 20px; padding: 12px 15px; background: #f8f9fa; border-radius: 6px; border: 1px solid #e5e7eb; } .diagnosis-title { font-size: 10px; font-weight: 600; color: #0e9f8e; margin: 0 0 6px 0; text-transform: uppercase; } .diagnosis-text { font-size: 10px; line-height: 1.4; color: #4b5563; } /* Footer Section */ .footer { position: absolute; bottom: 20px; left: 20px; right: 20px; } .signature-section { display: flex; justify-content: space-between; gap: 40px; margin-bottom: 20px; } .signature-box { flex: 1; text-align: center; } .signature-line { border-bottom: 1px solid #999; height: 40px; margin-bottom: 5px; } .signature-label { font-size: 9px; color: #666; line-height: 1.3; } .footer-info { text-align: center; padding-top: 15px; border-top: 1px solid #e5e7eb; } .footer-text { font-size: 8px; color: #6b7280; line-height: 1.5; } .footer-brand { margin-top: 8px; font-size: 7px; color: #9ca3af; border-top: 1px solid #f3f4f6; padding-top: 6px; } /* Watermark removed */ </style></head><body><div class="prescription-container"><div class="header"><div class="logo-section"><img src="https://example.test/logo.png" alt="Practice Logo" class="logo"><div class="practice-name">Example Practice</div></div><div class="practice-details"><div>12 Example Street</div><div>Windhoek, Namibia 9000</div><div>Tel: +264 61 000 0000</div><div>Email: reception@example.test</div><div>Practice No: 0000000</div></div></div><div class="title-section"><div class="rx-title"><span class="prescription-title">MEDICAL PRESCRIPTION</span><span class="prescription-number">#RX-A1B2C3D4</span></div><div class="date-info"><div class="date-box"><div class="date-label">DATE ISSUED</div><div class="date-value">15 Oct 2026</div></div></div></div><div class="patient-section"><h3 class="section-title">PREPARED FOR</h3><div class="patient-info"><div class="patient-details"><div class="patient-name">Anna Example</div><div class="patient-detail-line">+264 81 000 0001</div><div class="patient-detail-line">anna@example.test</div><div class="patient-detail-line">7 Sample Road</div></div><div class="patient-details" style="text-align: right;"><div class="patient-name">EMF</div><div class="patient-detail-line">Scheme: Example Plus</div><div class="patient-detail-line">Member: EX1234567</div></div></div></div><div class="medications-section"><h3 class="medications-title">PRESCRIBED MEDICATIONS</h3><table class="medications-table"><thead><tr><th style="width: 30%">Medication</th><th style="width: 15%">Dosage</th><th style="width: 15%">Frequency</th><th style="width: 15%">Duration</th><th style="width: 25%">Instructions</th></tr></thead><tbody><tr><td class="medication-name">Amoxicillin 500 mg</td><td>1 capsule</td><td>Three times a day</td><td>5 days</td><td>Finish the course</td></tr><tr><td class="medication-name">Paracetamol 500 mg</td><td>2 tablets</td><td>Every 6 hours when needed</td><td>3 days</td><td>No more than 8 a day</td></tr></tbody></table></div><div class="footer"><div class="signature-section"><div class="signature-box"><div class="signature-line"></div><div class="signature-label">Patient Signature</div></div><div class="signature-box"><div class="signature-line" style="display: flex; align-items: center; justify-content: center;"></div><div class="signature-label"> Dr A Example<br> Prescribing Physician </div></div></div><div class="footer-info"><p class="footer-text"> This prescription is valid for 30 days from the date of issue.<br> For inquiries: +264 61 000 0000 • reception@example.test </p><div class="footer-brand"> Prescription generated by <strong>OneHealth Systems</strong> • www.onehealthsystems.com • © 2024 </div></div></div></div></body></html>"`;
