import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { Icon } from '@iconify/react';
import FullScreenModal from '../ui/FullScreenModal';
import { supabase } from '../../lib/supabase';
import { wardManagementService } from '../../services/wardManagementService';
import { roomManagementService } from '../../services/roomManagementService';
import { toast } from 'react-hot-toast';
import { PremiumInput, PremiumTextarea, PremiumSelect } from '../ui/PremiumInput';
import CreateWardModal from './modals/CreateWardModal';
import CreateRoomModal from './modals/CreateRoomModal';
import CreateBedModal from './modals/CreateBedModal';
import EditWardModal from './modals/EditWardModal';
import EditRoomModal from './modals/EditRoomModal';
import EditBedModal from './modals/EditBedModal';
import { useAuthStore } from '../../stores/authStore';

interface FullScreenDepartmentModalProps {
  isOpen: boolean;
  onClose: () => void;
  departmentId: string;
  practiceId: string;
  onSuccess: () => void;
}

interface Department {
  id: string;
  name: string;
  code?: string;
  description?: string;
  is_active: boolean;
  practice_id: string;
  created_at: string;
  updated_at: string;
  head_user_id?: string;
  color?: string;
  // Additional fields for display/UI purposes (may be stored elsewhere)
  head_of_department?: string;
  contact_email?: string;
  contact_phone?: string;
  location?: string;
  // Aliases for compatibility
  department_name?: string;
  department_code?: string;
}

interface Staff {
  id: string;
  full_name: string;
  email?: string;
  role?: string;
  job_title?: string;
  avatar?: string;
}

const departmentColors = [
  { name: 'Purple', value: '#8B5CF6', gradient: 'from-purple-400 to-purple-600' },
  { name: 'Blue', value: '#3B82F6', gradient: 'from-blue-400 to-blue-600' },
  { name: 'Cyan', value: '#06B6D4', gradient: 'from-cyan-400 to-cyan-600' },
  { name: 'Green', value: '#10B981', gradient: 'from-green-400 to-green-600' },
  { name: 'Amber', value: '#F59E0B', gradient: 'from-amber-400 to-amber-600' },
  { name: 'Red', value: '#EF4444', gradient: 'from-red-400 to-red-600' },
  { name: 'Pink', value: '#EC4899', gradient: 'from-pink-400 to-pink-600' },
  { name: 'Indigo', value: '#6366F1', gradient: 'from-indigo-400 to-indigo-600' },
  { name: 'Teal', value: '#14B8A6', gradient: 'from-teal-400 to-teal-600' },
  { name: 'Orange', value: '#FB923C', gradient: 'from-orange-400 to-orange-600' },
];

interface Tab {
  id: string;
  label: string;
  icon: string;
  tooltip?: string;
  badge?: number;
}

const FullScreenDepartmentModal: React.FC<FullScreenDepartmentModalProps> = ({
  isOpen,
  onClose,
  departmentId,
  practiceId,
  onSuccess
}) => {
  const { user } = useAuthStore();
  const [activeTab, setActiveTab] = useState<string>('general');
  const [department, setDepartment] = useState<Department | null>(null);
  const [loading, setLoading] = useState(true);
  const [hoveredTab, setHoveredTab] = useState<string | null>(null);
  const [wards, setWards] = useState<any[]>([]);
  const [rooms, setRooms] = useState<any[]>([]);
  const [beds, setBeds] = useState<any[]>([]);
  const [practiceStaff, setPracticeStaff] = useState<Staff[]>([]);
  const [selectedHeadUser, setSelectedHeadUser] = useState<Staff | null>(null);
  const [stats, setStats] = useState({
    totalWards: 0,
    totalRooms: 0,
    totalBeds: 0,
    availableBeds: 0,
    occupiedBeds: 0
  });
  const [isEditing, setIsEditing] = useState(false);
  const [editFormData, setEditFormData] = useState<Department | null>(null);

  // Modal states
  const [isCreateWardOpen, setIsCreateWardOpen] = useState(false);
  const [isCreateRoomOpen, setIsCreateRoomOpen] = useState(false);
  const [isCreateBedOpen, setIsCreateBedOpen] = useState(false);
  const [selectedWardId, setSelectedWardId] = useState<string>('');
  const [selectedRoom, setSelectedRoom] = useState<any>(null);
  const [selectedBed, setSelectedBed] = useState<any>(null);
  const [selectedWard, setSelectedWard] = useState<any>(null);
  const [isEditWardOpen, setIsEditWardOpen] = useState(false);
  const [isEditRoomOpen, setIsEditRoomOpen] = useState(false);
  const [isEditBedOpen, setIsEditBedOpen] = useState(false);

  const tabs: Tab[] = [
    {
      id: 'general',
      label: 'General',
      icon: 'solar:info-circle-bold-duotone',
      tooltip: 'Department details and information'
    },
    {
      id: 'wards',
      label: 'Wards',
      icon: 'solar:hospital-bold-duotone',
      tooltip: 'Manage hospital wards',
      badge: stats.totalWards
    },
    {
      id: 'rooms',
      label: 'Rooms',
      icon: 'solar:home-bold-duotone',
      tooltip: 'Manage rooms within wards',
      badge: stats.totalRooms
    },
    {
      id: 'beds',
      label: 'Beds',
      icon: 'solar:bed-bold-duotone',
      tooltip: 'Manage hospital beds',
      badge: stats.totalBeds
    },
    {
      id: 'staff',
      label: 'Staff',
      icon: 'solar:users-group-rounded-bold-duotone',
      tooltip: 'Department staff members'
    },
    {
      id: 'statistics',
      label: 'Statistics',
      icon: 'solar:chart-bold-duotone',
      tooltip: 'Department analytics and reports'
    }
  ];

  useEffect(() => {
    if (departmentId && isOpen) {
      fetchPracticeStaff();
      fetchDepartmentDetails();
      fetchDepartmentData();
    }
  }, [departmentId, isOpen]);

  const fetchPracticeStaff = async () => {
    try {
      const { data, error } = await supabase
        .from('users')
        .select('id, full_name, email, role, job_title, avatar')
        .eq('practice_id', practiceId)
        .order('full_name');

      if (error) throw error;
      setPracticeStaff(data || []);
    } catch (error) {
      console.error('Error fetching practice staff:', error);
    }
  };

  const fetchDepartmentDetails = async () => {
    try {
      setLoading(true);
      const { data, error } = await supabase
        .from('departments')
        .select('*')
        .eq('id', departmentId)
        .single();

      if (error) throw error;
      setDepartment(data);

      // Fetch the department head details separately if head_user_id exists
      if (data?.head_user_id) {
        const { data: userData, error: userError } = await supabase
          .from('users')
          .select('id, full_name, email, role, job_title, avatar')
          .eq('id', data.head_user_id)
          .single();

        if (!userError && userData) {
          setSelectedHeadUser(userData);
        }
      }
    } catch (error) {
      console.error('Error fetching department:', error);
    } finally {
      setLoading(false);
    }
  };

  const fetchDepartmentData = async () => {
    try {
      // Fetch wards
      const { data: wardsData, error: wardsError } = await wardManagementService.getWardsByDepartment(departmentId);
      if (!wardsError && wardsData) {
        setWards(wardsData);

        // Calculate statistics
        let totalRooms = 0;
        let totalBeds = 0;
        let availableBeds = 0;
        let occupiedBeds = 0;
        let allRooms: any[] = [];
        let allBeds: any[] = [];

        for (const ward of wardsData) {
          totalBeds += ward.total_beds || 0;
          availableBeds += ward.available_beds || 0;
          occupiedBeds += ward.occupied_beds || 0;

          // Get rooms for each ward
          const { data: roomsData } = await roomManagementService.getRoomsByWard(ward.id);
          if (roomsData) {
            totalRooms += roomsData.length;
            allRooms = [...allRooms, ...roomsData];

            // Collect all beds
            for (const room of roomsData) {
              allBeds = [...allBeds, ...room.beds];
            }
          }
        }

        setRooms(allRooms);
        setBeds(allBeds);
        setStats({
          totalWards: wardsData.length,
          totalRooms,
          totalBeds,
          availableBeds,
          occupiedBeds
        });
      }
    } catch (error) {
      console.error('Error fetching department data:', error);
    }
  };

  const handleSuccess = () => {
    fetchDepartmentData();
    fetchDepartmentDetails();
    onSuccess();
  };

  const handleEditDepartment = () => {
    // Map the department data to include both naming conventions
    const mappedData = department ? {
      ...department,
      department_name: department.name || department.department_name,
      department_code: department.code || department.department_code
    } : null;
    setEditFormData(mappedData);
    setIsEditing(true);
  };

  const handleSaveDepartment = async () => {
    if (!editFormData) return;

    try {
      // Use the correct column names based on the actual table schema
      const updateData: any = {
        name: editFormData.name || editFormData.department_name,
        code: editFormData.code || editFormData.department_code,
        description: editFormData.description,
        is_active: editFormData.is_active,
        color: editFormData.color,
        head_user_id: editFormData.head_user_id,
        updated_at: new Date().toISOString()
      };

      const { error } = await supabase
        .from('departments')
        .update(updateData)
        .eq('id', departmentId);

      if (error) throw error;

      toast.success('Department updated successfully');
      setIsEditing(false);
      // Update local state with new data
      setDepartment({ ...department, ...updateData });
      handleSuccess();
    } catch (error) {
      console.error('Error updating department:', error);
      toast.error('Failed to update department');
    }
  };

  const renderHeader = () => (
    <div className="relative bg-gradient-to-r from-purple-500 to-indigo-600 p-6 text-white">
      <div className="absolute inset-0 bg-gradient-to-r from-purple-500/20 to-indigo-600/20 backdrop-blur-sm"></div>
      <div className="relative flex items-center justify-between">
        <div className="flex items-center gap-4">
          <div className="p-3 bg-white/20 rounded-xl backdrop-blur-sm">
            <Icon icon="solar:hospital-bold-duotone" className="w-6 h-6" />
          </div>
          <div>
            <h2 className="text-2xl font-bold">Department Management</h2>
            {department && (
              <p className="text-blue-100 text-sm">
                {department.name || department.department_name} • {department.code || department.department_code || 'No code'} • {department.is_active ? 'Active' : 'Inactive'}
              </p>
            )}
          </div>
        </div>
        <button
          type="button"
          onClick={(e) => {
            e.preventDefault();
            e.stopPropagation();
            onClose();
          }}
          className="p-2 bg-white/20 rounded-lg hover:bg-white/30 transition-colors"
        >
          <Icon icon="solar:close-circle-bold-duotone" className="w-5 h-5" />
        </button>
      </div>
    </div>
  );

  const renderTabs = () => (
    <div className="bg-white border-b border-gray-200/50 relative">
      {/* Mobile: Horizontal scroll tabs | Desktop: Full width tabs */}
      <div className="px-4 sm:px-6">
        <div className="flex overflow-x-auto scrollbar-none md:overflow-x-visible" role="tablist">
          {tabs.map((tab, index) => {
            const isActive = activeTab === tab.id;
            const isHovered = hoveredTab === tab.id;

            return (
              <motion.button
                key={tab.id}
                type="button"
                initial={{ opacity: 0, y: 10 }}
                animate={{
                  opacity: 1,
                  y: 0
                }}
                transition={{
                  opacity: { delay: index * 0.05, duration: 0.2 },
                  y: { delay: index * 0.05, duration: 0.2 }
                }}
                whileHover={{
                  scale: 1.002,
                  transition: { duration: 0.2 }
                }}
                whileTap={{ scale: 0.998 }}
                onClick={(e) => {
                  e.preventDefault();
                  e.stopPropagation();
                  setActiveTab(tab.id);
                }}
                onMouseEnter={() => setHoveredTab(tab.id)}
                onMouseLeave={() => setHoveredTab(null)}
                className={`
                  flex-shrink-0 md:flex-1
                  flex items-center justify-center gap-2
                  px-3 sm:px-4 py-4
                  min-w-[120px] md:min-w-0
                  min-h-[48px]
                  text-xs sm:text-sm font-medium
                  border-b-2 transition-all duration-200
                  relative group cursor-pointer
                  touch-manipulation
                  ${isActive
                    ? 'text-purple-600 border-purple-600 bg-gradient-to-t from-purple-50/50 to-transparent'
                    : 'text-gray-500 border-transparent hover:text-purple-600 hover:bg-purple-50/30'
                  }
                `}
                aria-label={tab.label}
                role="tab"
                aria-selected={isActive}
                tabIndex={isActive ? 0 : -1}
              >
                {/* Tooltip - Hidden on mobile for better UX */}
                {tab.tooltip && isHovered && !isActive && (
                  <motion.div
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    exit={{ opacity: 0, y: 10 }}
                    className="absolute -top-10 left-1/2 transform -translate-x-1/2 px-3 py-1 bg-gray-900 text-white text-xs rounded-lg whitespace-nowrap z-50 pointer-events-none hidden sm:block"
                  >
                    {tab.tooltip}
                    <div className="absolute -bottom-1 left-1/2 transform -translate-x-1/2 w-2 h-2 bg-gray-900 rotate-45" />
                  </motion.div>
                )}

                <Icon icon={tab.icon} className={`w-4 h-4 sm:w-5 sm:h-5 transition-all duration-200 flex-shrink-0 ${
                  isActive ? 'text-purple-600' : ''
                }`} />

                {/* Always show text on mobile, but make it smaller */}
                <span className="font-medium whitespace-nowrap text-xs sm:text-sm">{tab.label}</span>

                {tab.badge && tab.badge > 0 && (
                  <span className="ml-1 bg-purple-100 text-purple-600 px-2 py-0.5 rounded-full text-xs font-semibold">
                    {tab.badge}
                  </span>
                )}

                {/* Active indicator */}
                {isActive && (
                  <>
                    {/* Bottom border shadow/glow */}
                    <motion.div
                      className="absolute -bottom-0.5 left-0 right-0 h-3 shadow-lg shadow-purple-500/20"
                      initial={{ opacity: 0 }}
                      animate={{ opacity: 1 }}
                      transition={{ duration: 0.3, ease: "easeOut" }}
                    />

                    {/* White rounded indicator */}
                    <motion.div
                      className="absolute -bottom-1.5 left-0 right-0 mx-auto w-8 h-1 bg-white rounded-full"
                      initial={{ width: 0, opacity: 0 }}
                      animate={{ width: 32, opacity: 1 }}
                      transition={{ duration: 0.3, ease: "easeOut" }}
                    />

                    {/* Simple active line indicator */}
                    <motion.div
                      className="absolute bottom-0 left-0 right-0 h-0.5 bg-purple-600"
                      initial={{ scaleX: 0, opacity: 0 }}
                      animate={{ scaleX: 1, opacity: 1 }}
                      transition={{ duration: 0.3, ease: "easeOut" }}
                    />
                  </>
                )}
              </motion.button>
            );
          })}
        </div>
      </div>
    </div>
  );

  const renderGeneralTab = () => {
    return (
      <div className="p-6 space-y-6">
        {/* Header Section with White Background - Always visible */}
        <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="p-2 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 shadow-md">
                <Icon icon="solar:hospital-bold-duotone" className="w-5 h-5 text-white" />
              </div>
              <div>
                <h3 className="text-lg font-semibold text-gray-800">
                  General Information
                </h3>
                <p className="text-sm text-gray-600">Visit details, clinical notes, and encounter information</p>
              </div>
            </div>
            {isEditing ? (
              <div className="flex gap-2">
                <button
                onClick={() => {
                  setIsEditing(false);
                  setEditFormData(null);
                }}
                className="px-4 py-2 text-sm font-bold rounded-lg transition-all flex items-center gap-2 bg-gray-100 text-gray-600 hover:bg-gray-200"
              >
                Cancel
              </button>
                <button
                onClick={handleSaveDepartment}
                className="px-4 py-2 text-sm font-bold rounded-lg transition-all flex items-center gap-2 bg-purple-100 text-purple-600 hover:bg-purple-200"
              >
                <Icon icon="solar:diskette-bold-duotone" className="w-4 h-4" />
                Save Department
              </button>
              </div>
            ) : (
              <button
              onClick={handleEditDepartment}
              className="px-4 py-2 text-sm font-bold rounded-lg transition-all flex items-center gap-2 bg-purple-100 text-purple-600 hover:bg-purple-200"
            >
              <Icon icon="solar:pen-bold-duotone" className="w-4 h-4" />
              Edit Department
            </button>
            )}
          </div>
        </div>

        {isEditing ? (
          <div className="space-y-6">
            {/* Department Information Section - White Background */}
            <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
              <div className="flex items-center mb-4">
                <div className="p-2 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-600 shadow-md">
                  <Icon icon="solar:hospital-bold-duotone" className="w-5 h-5 text-white" />
                </div>
                <div className="ml-3">
                  <h3 className="text-lg font-semibold text-gray-800">Department Information</h3>
                  <p className="text-sm text-gray-600">Basic department details and configuration</p>
                </div>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Department Name</label>
                  <PremiumInput
                    type="text"
                    value={editFormData?.department_name || editFormData?.name || ''}
                    onChange={(e) => setEditFormData({ ...editFormData!, department_name: e.target.value, name: e.target.value })}
                    placeholder="e.g., Emergency Department"
                    icon="solar:hospital-bold-duotone"
                    iconColor="text-purple-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Department Code</label>
                  <PremiumInput
                    type="text"
                    value={editFormData?.department_code || editFormData?.code || ''}
                    onChange={(e) => setEditFormData({ ...editFormData!, department_code: e.target.value, code: e.target.value })}
                    placeholder="e.g., MED-01"
                    icon="solar:code-bold-duotone"
                    iconColor="text-indigo-500"
                  />
                </div>
                <div className="md:col-span-2">
                  <label className="block text-sm font-medium text-gray-700 mb-2">Description</label>
                  <PremiumTextarea
                    value={editFormData?.description || ''}
                    onChange={(e) => setEditFormData({ ...editFormData!, description: e.target.value })}
                    placeholder="Department description..."
                    rows={3}
                    icon="solar:document-text-bold-duotone"
                    iconColor="text-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Status</label>
                  <PremiumSelect
                    value={editFormData?.is_active ? 'active' : 'inactive'}
                    onChange={(e) => setEditFormData({ ...editFormData!, is_active: e.target.value === 'active' })}
                    icon="solar:shield-check-bold-duotone"
                    iconColor="text-green-500"
                  >
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </PremiumSelect>
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Department Color Theme</label>
                  <div className="bg-white p-3 rounded-lg border border-gray-200">
                    <div className="grid grid-cols-5 gap-3">
                      {departmentColors.map((color) => (
                        <button
                          key={color.value}
                          type="button"
                          onClick={() => setEditFormData({ ...editFormData!, color: color.value })}
                          className={`relative group transition-all duration-200 ${
                            editFormData?.color === color.value
                              ? 'scale-105'
                              : 'hover:scale-105'
                          }`}
                          title={color.name}
                        >
                          <div
                            className={`h-12 rounded-lg bg-gradient-to-br ${color.gradient} transition-all duration-200 ${
                              editFormData?.color === color.value
                                ? 'ring-2 ring-offset-2 ring-purple-500 shadow-lg'
                                : 'hover:shadow-md'
                            }`}
                          >
                            {editFormData?.color === color.value && (
                              <div className="absolute inset-0 flex items-center justify-center">
                                <div className="bg-white rounded-full p-1">
                                  <Icon icon="solar:check-circle-bold" className="w-4 h-4 text-purple-600" />
                                </div>
                              </div>
                            )}
                          </div>
                          <p className="text-xs mt-1 text-center font-medium text-gray-600 opacity-0 group-hover:opacity-100 transition-opacity">
                            {color.name}
                          </p>
                        </button>
                      ))}
                    </div>
                    {editFormData?.color && (
                      <div className="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
                        <div className="flex items-center gap-2">
                          <span className="text-xs text-gray-500">Selected:</span>
                          <div className="flex items-center gap-2">
                            <div
                              className="w-6 h-6 rounded-md border-2 border-gray-200 shadow-sm"
                              style={{ backgroundColor: editFormData.color }}
                            />
                            <span className="text-sm font-semibold text-gray-700">
                              {departmentColors.find(c => c.value === editFormData.color)?.name || 'Custom'}
                            </span>
                          </div>
                        </div>
                        <button
                          type="button"
                          onClick={() => setEditFormData({ ...editFormData!, color: undefined })}
                          className="text-xs text-gray-500 hover:text-red-500 transition-colors"
                        >
                          Clear
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>

          {/* Contact Information Section - White Background */}
          <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <div className="flex items-center mb-4">
              <div className="p-2 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 shadow-md">
                <Icon icon="solar:phone-bold-duotone" className="w-5 h-5 text-white" />
              </div>
              <div className="ml-3">
                <h3 className="text-lg font-semibold text-gray-800">Contact Information</h3>
                <p className="text-sm text-gray-600">Department head and contact details</p>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div className="md:col-span-2">
                  <label className="block text-sm font-medium text-gray-700 mb-2">Department Head</label>
                  <div className="space-y-2">
                    <div className="relative">
                      <PremiumSelect
                        value={editFormData?.head_user_id || ''}
                        onChange={(e) => {
                          const selectedStaff = practiceStaff.find(s => s.id === e.target.value);
                          setEditFormData({
                            ...editFormData!,
                            head_user_id: e.target.value,
                            head_of_department: selectedStaff?.full_name
                          });
                          setSelectedHeadUser(selectedStaff || null);
                        }}
                        icon="solar:user-bold-duotone"
                        iconColor="text-purple-500"
                      >
                        <option value="">Select department head...</option>
                        {practiceStaff.map((staff) => (
                          <option key={staff.id} value={staff.id}>
                            {staff.full_name} {staff.job_title || staff.role ? `- ${staff.job_title || staff.role}` : ''}
                          </option>
                        ))}
                      </PremiumSelect>
                      {/* Display avatars in dropdown preview */}
                      {editFormData?.head_user_id && (
                        <div className="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none">
                          {(() => {
                            const user = practiceStaff.find(s => s.id === editFormData.head_user_id);
                            return user?.avatar ? (
                              <img
                                src={user.avatar}
                                alt=""
                                className="w-8 h-8 rounded-full object-cover border-2 border-white shadow-sm"
                              />
                            ) : null;
                          })()}
                        </div>
                      )}
                    </div>
                  </div>
                  {selectedHeadUser && (
                    <div className="mt-2 p-3 bg-purple-50 rounded-lg flex items-center gap-3">
                      {selectedHeadUser.avatar ? (
                        <img
                          src={selectedHeadUser.avatar}
                          alt={selectedHeadUser.full_name}
                          className="w-10 h-10 rounded-full object-cover border-2 border-purple-200"
                        />
                      ) : (
                        <div className="w-10 h-10 rounded-full bg-gradient-to-br from-purple-400 to-indigo-500 flex items-center justify-center">
                          <Icon icon="solar:user-bold-duotone" className="w-6 h-6 text-white" />
                        </div>
                      )}
                      <div>
                        <p className="text-sm font-medium text-gray-900">{selectedHeadUser.full_name}</p>
                        <p className="text-xs text-gray-600">{selectedHeadUser.job_title || selectedHeadUser.role}</p>
                      </div>
                    </div>
                  )}
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Email</label>
                  <PremiumInput
                    type="email"
                    value={editFormData?.contact_email || ''}
                    onChange={(e) => setEditFormData({ ...editFormData!, contact_email: e.target.value })}
                    placeholder="department@example.com"
                    icon="solar:letter-bold-duotone"
                    iconColor="text-blue-500"
                  />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-2">Phone</label>
                  <PremiumInput
                    type="tel"
                    value={editFormData?.contact_phone || ''}
                    onChange={(e) => setEditFormData({ ...editFormData!, contact_phone: e.target.value })}
                    placeholder="+1234567890"
                    icon="solar:phone-bold-duotone"
                    iconColor="text-green-500"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div className="space-y-6">
          {/* Department Information Section */}
          <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <div className="flex items-center mb-4">
              <div className="p-2 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-600 shadow-md">
                <Icon icon="solar:hospital-bold-duotone" className="w-5 h-5 text-white" />
              </div>
              <div className="ml-3">
                <h3 className="text-lg font-semibold text-gray-800">Department Information</h3>
                <p className="text-sm text-gray-600">Basic department details and configuration</p>
              </div>
            </div>
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div className="space-y-4">
                  {/* Department Name with Color */}
                  <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <div className="flex items-center gap-3">
                      <div
                        className="p-2 rounded-lg"
                        style={{
                          background: `linear-gradient(135deg, ${department?.color || '#30b4be'}20, ${department?.color || '#2a9da6'}20)`
                        }}
                      >
                        <Icon
                          icon="solar:hospital-bold-duotone"
                          className="w-4 h-4"
                          style={{ color: department?.color || '#30b4be' }}
                        />
                      </div>
                      <div className="flex-1">
                        <span className="text-sm font-semibold text-gray-900">Department Name</span>
                        <p className="text-xs text-gray-600">{department?.name || department?.department_name}</p>
                        {department?.color && (
                          <div className="flex items-center gap-2 mt-1">
                            <div
                              className="w-5 h-5 rounded-md border-2 border-gray-200 shadow-sm"
                              style={{ backgroundColor: department.color }}
                            />
                            <span className="text-xs font-medium text-gray-600">
                              {departmentColors.find(c => c.value === department.color)?.name || department.color}
                            </span>
                          </div>
                        )}
                      </div>
                    </div>
                  </div>

                  {/* Department Code */}
                  <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <div className="flex items-center gap-3">
                      <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                        <Icon icon="solar:code-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                      </div>
                      <div className="flex-1">
                        <span className="text-sm font-semibold text-gray-900">Department Code</span>
                        <p className="text-xs text-gray-600">{department?.code || department?.department_code || 'Not set'}</p>
                      </div>
                    </div>
                  </div>

                  {/* Additional Options */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                      <div className="flex items-center gap-3 mb-2">
                        <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                          <Icon icon="solar:document-text-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                        </div>
                        <span className="text-sm font-semibold text-gray-900">Description</span>
                      </div>
                      <p className="text-xs text-gray-600">{department?.description || 'No description'}</p>
                    </div>

                    <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                      <div className="flex items-center gap-3 mb-2">
                        <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                          <Icon icon="solar:shield-check-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                        </div>
                        <span className="text-sm font-semibold text-gray-900">Status</span>
                      </div>
                      <p className="text-xs text-gray-600">
                        <span className={`inline-flex px-2 py-0.5 text-xs font-medium rounded-full ${
                          department?.is_active
                            ? 'bg-green-100 text-green-700'
                            : 'bg-gray-100 text-gray-700'
                        }`}>
                          {department?.is_active ? 'Active' : 'Inactive'}
                        </span>
                      </p>
                    </div>
                  </div>
                </div>
            </div>
          </div>

          {/* Contact Information Section */}
          <div className="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
            <div className="flex items-center mb-4">
              <div className="p-2 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 shadow-md">
                <Icon icon="solar:phone-bold-duotone" className="w-5 h-5 text-white" />
              </div>
              <div className="ml-3">
                <h3 className="text-lg font-semibold text-gray-800">Contact Information</h3>
                <p className="text-sm text-gray-600">Department head and contact details</p>
              </div>
            </div>
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div className="space-y-4">
                  {/* Head of Department */}
                  <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <div className="flex items-center gap-3">
                      {department?.head_user_id ? (
                        <>
                          {(() => {
                            const headUser = practiceStaff.find(s => s.id === department.head_user_id);
                            return headUser?.avatar ? (
                              <img
                                src={headUser.avatar}
                                alt={headUser.full_name}
                                className="w-10 h-10 rounded-full object-cover border-2 border-purple-200"
                              />
                            ) : (
                              <div className="w-10 h-10 rounded-full bg-gradient-to-br from-purple-400 to-indigo-500 flex items-center justify-center">
                                <Icon icon="solar:user-bold-duotone" className="w-6 h-6 text-white" />
                              </div>
                            );
                          })()}
                          <div className="flex-1">
                            <span className="text-sm font-semibold text-gray-900">Head of Department</span>
                            <p className="text-xs text-gray-600">
                              {practiceStaff.find(s => s.id === department.head_user_id)?.full_name || 'Not assigned'}
                            </p>
                            {practiceStaff.find(s => s.id === department.head_user_id)?.job_title && (
                              <p className="text-xs text-gray-500">
                                {practiceStaff.find(s => s.id === department.head_user_id)?.job_title}
                              </p>
                            )}
                          </div>
                        </>
                      ) : (
                        <>
                          <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                            <Icon icon="solar:user-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                          </div>
                          <div className="flex-1">
                            <span className="text-sm font-semibold text-gray-900">Head of Department</span>
                            <p className="text-xs text-gray-600">Not assigned</p>
                          </div>
                        </>
                      )}
                    </div>
                  </div>

                  {/* Contact Details Grid */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                      <div className="flex items-center gap-3 mb-2">
                        <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                          <Icon icon="solar:letter-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                        </div>
                        <span className="text-sm font-semibold text-gray-900">Email</span>
                      </div>
                      <p className="text-xs text-gray-600">{department?.contact_email || 'Not set'}</p>
                    </div>

                    <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                      <div className="flex items-center gap-3 mb-2">
                        <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                          <Icon icon="solar:phone-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                        </div>
                        <span className="text-sm font-semibold text-gray-900">Phone</span>
                      </div>
                      <p className="text-xs text-gray-600">{department?.contact_phone || 'Not set'}</p>
                    </div>
                  </div>

                  {/* Location */}
                  <div className="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                    <div className="flex items-center gap-3">
                      <div className="p-2 rounded-lg" style={{ background: 'linear-gradient(135deg, #30b4be20, #2a9da620)' }}>
                        <Icon icon="solar:map-point-bold-duotone" className="w-4 h-4" style={{ color: '#30b4be' }} />
                      </div>
                      <div className="flex-1">
                        <span className="text-sm font-semibold text-gray-900">Location</span>
                        <p className="text-xs text-gray-600">{department?.location || 'Not set'}</p>
                      </div>
                    </div>
                  </div>
                </div>
            </div>
          </div>
        </div>
        )}
      </div>
    );
  };

  const renderWardsTab = () => (
    <div className="p-6">
      <div className="mb-4 flex justify-between items-center">
        <h3 className="text-lg font-semibold">Hospital Wards</h3>
        <button
          onClick={() => setIsCreateWardOpen(true)}
          className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2"
        >
          <Icon icon="solar:add-circle-bold-duotone" className="w-5 h-5" />
          Add Ward
        </button>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {wards.map((ward) => (
          <motion.div
            key={ward.id}
            whileHover={{ scale: 1.02 }}
            className="bg-white rounded-lg border border-gray-200 p-4 cursor-pointer hover:shadow-lg transition-shadow"
            onClick={() => {
              setSelectedWard(ward);
              setIsEditWardOpen(true);
            }}
          >
            <div className="flex justify-between items-start mb-3">
              <div>
                <h4 className="font-semibold text-gray-800">{ward.ward_name}</h4>
                <p className="text-sm text-gray-500">{ward.ward_code}</p>
              </div>
              <Icon icon="solar:hospital-bold-duotone" className="w-6 h-6 text-purple-500" />
            </div>

            <div className="space-y-2">
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Total Beds:</span>
                <span className="font-medium">{ward.total_beds || 0}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Available:</span>
                <span className="font-medium text-green-600">{ward.available_beds || 0}</span>
              </div>
              <div className="flex justify-between text-sm">
                <span className="text-gray-500">Occupied:</span>
                <span className="font-medium text-orange-600">{ward.occupied_beds || 0}</span>
              </div>
            </div>

            <div className="mt-3 pt-3 border-t border-gray-100">
              <div className="flex items-center justify-between">
                <span className={`inline-flex px-2 py-1 text-xs rounded-full ${
                  ward.is_active
                    ? 'bg-green-100 text-green-700'
                    : 'bg-gray-100 text-gray-700'
                }`}>
                  {ward.is_active ? 'Active' : 'Inactive'}
                </span>
                <button
                  className="text-purple-600 hover:text-purple-700"
                  onClick={(e) => {
                    e.stopPropagation();
                    setSelectedWard(ward);
                    setIsEditWardOpen(true);
                  }}
                >
                  <Icon icon="solar:pen-bold-duotone" className="w-4 h-4" />
                </button>
              </div>
            </div>
          </motion.div>
        ))}
      </div>
    </div>
  );

  const renderRoomsTab = () => (
    <div className="p-6">
      <div className="mb-4 flex justify-between items-center">
        <h3 className="text-lg font-semibold">Rooms</h3>
        <button
          onClick={() => {
            setSelectedWardId(wards[0]?.id || '');
            setIsCreateRoomOpen(true);
          }}
          className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2"
          disabled={wards.length === 0}
        >
          <Icon icon="solar:add-circle-bold-duotone" className="w-5 h-5" />
          Add Room
        </button>
      </div>

      {wards.length === 0 ? (
        <div className="text-center py-8 text-gray-500">
          <Icon icon="solar:home-bold-duotone" className="w-12 h-12 mx-auto mb-2 text-gray-300" />
          <p>No wards available. Create a ward first to add rooms.</p>
        </div>
      ) : (
        <div className="space-y-6">
          {wards.map((ward) => {
            const wardRooms = rooms.filter(r => r.ward_id === ward.id);
            return (
              <div key={ward.id} className="bg-white rounded-lg border border-gray-200 p-4">
                <h4 className="font-semibold text-gray-800 mb-3">{ward.ward_name}</h4>
                <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
                  {wardRooms.map((room) => (
                    <motion.div
                      key={`${ward.id}-${room.room_number}`}
                      whileHover={{ scale: 1.05 }}
                      className="bg-gradient-to-br from-purple-50 to-indigo-50 rounded-lg p-3 cursor-pointer hover:shadow-md transition-shadow"
                      onClick={() => {
                        setSelectedRoom(room);
                        setSelectedWardId(ward.id);
                        setIsEditRoomOpen(true);
                      }}
                    >
                      <Icon icon="solar:home-bold-duotone" className="w-6 h-6 text-purple-500 mb-1" />
                      <p className="font-semibold text-sm">{room.room_number}</p>
                      <p className="text-xs text-gray-500">{room.room_type || 'Standard'}</p>
                      <div className="mt-2 flex items-center gap-1">
                        <Icon icon="solar:bed-bold-duotone" className="w-4 h-4 text-gray-400" />
                        <span className="text-xs">{room.total_beds}</span>
                        <span className="text-xs text-green-600 ml-auto">{room.available_beds} free</span>
                      </div>
                    </motion.div>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );

  const renderBedsTab = () => (
    <div className="p-6">
      <div className="mb-4 flex justify-between items-center">
        <h3 className="text-lg font-semibold">Beds Management</h3>
        <button
          onClick={() => {
            setSelectedWardId(wards[0]?.id || '');
            setIsCreateBedOpen(true);
          }}
          className="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2"
          disabled={wards.length === 0}
        >
          <Icon icon="solar:add-circle-bold-duotone" className="w-5 h-5" />
          Add Beds
        </button>
      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {beds.map((bed) => {
          const statusColors = {
            available: 'bg-green-100 text-green-700 border-green-300',
            occupied: 'bg-orange-100 text-orange-700 border-orange-300',
            maintenance: 'bg-yellow-100 text-yellow-700 border-yellow-300',
            reserved: 'bg-blue-100 text-blue-700 border-blue-300',
            cleaning: 'bg-purple-100 text-purple-700 border-purple-300',
            blocked: 'bg-red-100 text-red-700 border-red-300'
          };

          const statusIcons = {
            available: 'solar:check-circle-bold-duotone',
            occupied: 'solar:user-bold-duotone',
            maintenance: 'solar:settings-bold-duotone',
            reserved: 'solar:time-bold-duotone',
            cleaning: 'solar:broom-bold-duotone',
            blocked: 'solar:close-circle-bold-duotone'
          };

          return (
            <motion.div
              key={bed.id}
              whileHover={{ scale: 1.05 }}
              className={`rounded-lg border-2 p-3 cursor-pointer transition-all ${
                statusColors[bed.status as keyof typeof statusColors]
              }`}
              onClick={() => {
                setSelectedBed(bed);
                setIsEditBedOpen(true);
              }}
            >
              <Icon icon={statusIcons[bed.status as keyof typeof statusIcons]} className="w-6 h-6 mb-1" />
              <p className="font-semibold text-sm">{bed.bed_number}</p>
              <p className="text-xs">{bed.room_number || 'Unassigned'}</p>
              <p className="text-xs capitalize mt-1">{bed.status}</p>
            </motion.div>
          );
        })}
      </div>
    </div>
  );

  const renderContent = () => {
    switch (activeTab) {
      case 'general':
        return renderGeneralTab();
      case 'wards':
        return renderWardsTab();
      case 'rooms':
        return renderRoomsTab();
      case 'beds':
        return renderBedsTab();
      case 'staff':
        return (
          <div className="p-6 text-center text-gray-500">
            <Icon icon="solar:users-group-rounded-bold-duotone" className="w-12 h-12 mx-auto mb-2 text-gray-300" />
            <p>Staff management coming soon</p>
          </div>
        );
      case 'statistics':
        return (
          <div className="p-6 text-center text-gray-500">
            <Icon icon="solar:chart-bold-duotone" className="w-12 h-12 mx-auto mb-2 text-gray-300" />
            <p>Statistics and reports coming soon</p>
          </div>
        );
      default:
        return null;
    }
  };

  return (
    <>
      <FullScreenModal
        isOpen={isOpen}
        onClose={onClose}
      >
        <div className="flex flex-col h-full bg-white">
          {renderHeader()}
          {renderTabs()}
          <div className="flex-1 overflow-y-auto bg-gray-50">
            <div className="w-full">
              {loading ? (
                <div className="flex items-center justify-center h-64">
                  <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
                </div>
              ) : (
                renderContent()
              )}
            </div>
          </div>
        </div>
      </FullScreenModal>

      {/* Ward Modals */}
      {isCreateWardOpen && (
        <CreateWardModal
          isOpen={isCreateWardOpen}
          onClose={() => setIsCreateWardOpen(false)}
          practiceId={practiceId}
          departmentId={departmentId}
          onSuccess={handleSuccess}
        />
      )}

      {isEditWardOpen && selectedWard && (
        <EditWardModal
          isOpen={isEditWardOpen}
          onClose={() => {
            setIsEditWardOpen(false);
            setSelectedWard(null);
          }}
          ward={selectedWard}
          practiceId={practiceId}
          onSuccess={handleSuccess}
        />
      )}

      {/* Room Modals */}
      {isCreateRoomOpen && (
        <CreateRoomModal
          isOpen={isCreateRoomOpen}
          onClose={() => setIsCreateRoomOpen(false)}
          practiceId={practiceId}
          wardId={selectedWardId}
          onSuccess={handleSuccess}
        />
      )}

      {isEditRoomOpen && selectedRoom && (
        <EditRoomModal
          isOpen={isEditRoomOpen}
          onClose={() => {
            setIsEditRoomOpen(false);
            setSelectedRoom(null);
          }}
          room={selectedRoom}
          practiceId={practiceId}
          wardId={selectedWardId}
          onSuccess={handleSuccess}
        />
      )}

      {/* Bed Modals */}
      {isCreateBedOpen && (
        <CreateBedModal
          isOpen={isCreateBedOpen}
          onClose={() => setIsCreateBedOpen(false)}
          practiceId={practiceId}
          wardId={selectedWardId}
          onSuccess={handleSuccess}
        />
      )}

      {isEditBedOpen && selectedBed && (
        <EditBedModal
          isOpen={isEditBedOpen}
          onClose={() => {
            setIsEditBedOpen(false);
            setSelectedBed(null);
          }}
          bed={selectedBed}
          practiceId={practiceId}
          onSuccess={handleSuccess}
        />
      )}
    </>
  );
};

export default FullScreenDepartmentModal;