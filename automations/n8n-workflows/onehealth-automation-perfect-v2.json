      "parameters": {
        "jsCode": "// Merge all results\nconst allResults = $input.all();\nconst updates = [];\n\nallResults.forEach(result => {\n  if (result.json.automation_id) {\n    updates.push({\n      id: result.json.automation_id,\n      status: 'completed',\n      processed_at: new Date().toISOString()\n    });\n  } else if (result.json.automations) {\n    // Handle SMS batch results\n    result.json.automations.forEach(automation => {\n      updates.push({\n        id: automation.id,\n        status: 'completed',\n        processed_at: new Date().toISOString()\n      });\n    });\n  }\n});\n\nconsole.log(`Updating ${updates.length} automation statuses`);\nreturn updates.map(update => ({ json: update }));"
