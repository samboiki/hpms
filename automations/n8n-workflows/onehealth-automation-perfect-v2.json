        "jsCode": "// Split NewCharm automations by type\nconst automations = $json.automations || [];\nconst smsAutomations = automations.filter(a => a.type === 'SMS');\nconst emailAutomations = automations.filter(a => a.type === 'EMAIL');\n\nconsole.log(`NewCharm: ${smsAutomations.length} SMS, ${emailAutomations.length} Email`);\n\nreturn [\n  {\n    json: {\n      practice_id: $json.practice_id,\n      practice_name: 'NewCharm',\n      type: 'SMS',\n      automations: smsAutomations\n    }\n  },\n  {\n    json: {\n      practice_id: $json.practice_id,\n      practice_name: 'NewCharm',  \n      type: 'EMAIL',\n      automations: emailAutomations\n    }\n  }\n];"
