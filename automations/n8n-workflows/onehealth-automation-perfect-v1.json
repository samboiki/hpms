    {
      "parameters": {
        "jsCode": "// Parse and prepare automations with practice grouping\nconst items = $input.all();\nlet automations = [];\n\ntry {\n  if (items && items.length > 0) {\n    const firstItem = items[0].json;\n    \n    if (Array.isArray(firstItem)) {\n      automations = firstItem;\n    } else if (firstItem.data && Array.isArray(firstItem.data)) {\n      automations = firstItem.data;\n    }\n  }\n  \n  console.log(`Found ${automations.length} pending automations`);\n  \n  // Group by practice for efficient routing\n  const practiceGroups = {};\n  \n  automations.forEach(automation => {\n    const practiceId = automation.practice_id;\n    const practiceName = automation.practice_name || 'Unknown Practice';\n    \n    if (!practiceGroups[practiceId]) {\n      practiceGroups[practiceId] = {\n        practice_id: practiceId,\n        practice_name: practiceName,\n        gmail_credentials: automation.gmail_credentials,\n        automations: []\n      };\n    }\n    \n    practiceGroups[practiceId].automations.push(automation);\n  });\n  \n  // Return practice groups for routing\n  return Object.values(practiceGroups).map(group => ({ json: group }));\n  \n} catch (error) {\n  console.error('Error processing automations:', error);\n  return [];\n}"
      },
      "id": "group_by_practice",
      "name": "🏢 Group by Practice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [650, 600]
