        "jsCode": "// Route to correct practice-specific nodes based on practice_id\nconst practiceId = $json.practice_id;\nconst practiceName = $json.practice_name;\n\n// Map practice IDs to their node outputs\nconst practiceRoutes = {\n  'ffed1160-00ec-4c4f-8810-913a24348d90': 0,  // NewCharm\n  'onehealth_practice_id': 1,  // OneHealth (replace with actual ID)\n};\n\n// Determine route\nconst routeIndex = practiceRoutes[practiceId] !== undefined ? practiceRoutes[practiceId] : 2; // Default route\n\n// Add routing info\n$json.route_index = routeIndex;\n$json.route_name = practiceName;\n\nconsole.log(`Routing ${practiceName} (${practiceId}) to route ${routeIndex}`);\n\nreturn $json;"
      },
