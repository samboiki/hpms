    {
      "parameters": {
        "jsCode": "// Collect all results and prepare status updates\nconst results = $input.all();\nconst updates = [];\n\nresults.forEach(result => {\n  const automations = result.json.automations || [];\n  const success = result.json.success !== false;\n  const error = result.json.error || null;\n  \n  automations.forEach(automation => {\n    if (automation.id) {\n      updates.push({\n        id: automation.id,\n        status: success ? 'completed' : 'failed',\n        processed_at: new Date().toISOString(),\n        error_message: error\n      });\n    }\n  });\n});\n\nconsole.log(`Preparing ${updates.length} status updates`);\n\nreturn updates.map(update => ({ json: update }));"
      },
