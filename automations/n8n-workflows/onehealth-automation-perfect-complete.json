      "parameters": {
        "jsCode": "// Collect NewCharm results\nconst results = $input.all();\nconst successItems = [];\n\nresults.forEach(result => {\n  if (result.json.automation_id) {\n    // Email result\n    successItems.push({\n      id: result.json.automation_id,\n      type: 'EMAIL',\n      practice_id: result.json.practice_id\n    });\n  } else if (result.json.automations) {\n    // SMS batch result\n    result.json.automations.forEach(automation => {\n      successItems.push({\n        id: automation.id,\n        type: 'SMS',\n        practice_id: result.json.practice_id\n      });\n    });\n  }\n});\n\nreturn successItems.map(item => ({ json: item }));"
