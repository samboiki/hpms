      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 600],
      "notesInFlow": true,
      "notes": "Timing is handled by the Supabase function.\nget_all_pending_automations only returns\nautomations that are due based on their\nscheduled_for timestamp."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/get_all_pending_automations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": false,
        "options": {
          "timeout": 30000
        }
      },
      "id": "get_pending",
      "name": "🔍 Get All Pending Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 600],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse response and group by practice\nconst items = $input.all();\nlet automations = [];\n\n// Extract automations array\nif (items && items.length > 0) {\n  const firstItem = items[0].json;\n  if (Array.isArray(firstItem)) {\n    automations = firstItem;\n  } else if (firstItem.data && Array.isArray(firstItem.data)) {\n    automations = firstItem.data;\n  }\n}\n\nconsole.log(`Found ${automations.length} pending automations`);\n\n// Group by practice\nconst practiceGroups = {};\nautomations.forEach(automation => {\n  const practiceId = automation.practice_id;\n  if (!practiceGroups[practiceId]) {\n    practiceGroups[practiceId] = {\n      practice_id: practiceId,\n      practice_name: automation.practice_name,\n      automations: []\n    };\n  }\n  practiceGroups[practiceId].automations.push(automation);\n});\n\n// Return groups\nreturn Object.values(practiceGroups).map(group => ({ json: group }));"
      },
      "id": "group_practices",
      "name": "🏢 Group by Practice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [650, 600]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "split_batch",
      "name": "🔀 Split Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [850, 600]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.practice_id }}",
              "operation": "equals",
              "value2": "ffed1160-00ec-4c4f-8810-913a24348d90"
            }
          ]
        }
      },
      "id": "is_newcharm",
      "name": "Is NewCharm?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 600]
    },
    {
      "parameters": {
        "content": "## NewCharm Processing Branch\n\nPractice ID: ffed1160-00ec-4c4f-8810-913a24348d90",
        "height": 500,
        "width": 2400,
        "color": 2
      },
      "id": "note_newcharm",
      "name": "NewCharm Branch",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1300, 200]
    },
    {
      "parameters": {
        "jsCode": "// Process NewCharm automations in parallel\nconst automations = $json.automations || [];\nconst smsAutomations = automations.filter(a => a.type === 'SMS');\nconst emailAutomations = automations.filter(a => a.type === 'EMAIL');\n\nconsole.log(`NewCharm: ${smsAutomations.length} SMS, ${emailAutomations.length} Email`);\n\n// Create outputs for parallel processing\nconst outputs = [];\n\nif (smsAutomations.length > 0) {\n  outputs.push({\n    json: {\n      practice_id: $json.practice_id,\n      practice_name: 'NewCharm',\n      type: 'SMS',\n      automations: smsAutomations\n    }\n  });\n}\n\nif (emailAutomations.length > 0) {\n  outputs.push({\n    json: {\n      practice_id: $json.practice_id,\n      practice_name: 'NewCharm',  \n      type: 'EMAIL',\n      automations: emailAutomations\n    }\n  });\n}\n\n// If no automations, return empty result\nif (outputs.length === 0) {\n  outputs.push({\n    json: {\n      practice_id: $json.practice_id,\n      practice_name: 'NewCharm',\n      type: 'NONE',\n      automations: []\n    }\n  });\n}\n\nreturn outputs;"
      },
      "id": "newcharm_process",
      "name": "📊 Process NewCharm",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1350, 400]
