    {
      "parameters": {
        "jsCode": "// Process emails one by one\nconst emailAutomations = $json.automations || [];\nreturn emailAutomations.map(automation => ({\n  json: {\n    to: automation.recipient_email,\n    subject: automation.email_subject,\n    body: automation.email_content,\n    automation_id: automation.id,\n    practice_id: $json.practice_id,\n    practice_name: $json.practice_name\n  }\n}));"
      },
