{
  "name": "HPMS Automation Processor - All Types",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/get_pending_welcome_automations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.supabaseApiKey }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.supabaseApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"batch_size\": 100 }",
        "options": {}
      },
      "id": "get-pending-automations",
      "name": "Get Pending Automations (All Types)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.length > 0 }}",
              "value2": "={{ true }}"
            }
          ]
        }
      },
      "id": "check-if-any",
      "name": "Any Automations?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "split-batches",
      "name": "Process in Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [840, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sms_message",
              "name": "sms_message",
              "value": "={{ $json.sms_template ? $json.sms_template : 'Welcome to ' + $json.practice_name + ', ' + $json.payload.patientName + '! We look forward to caring for you. Save our number for easy access. Reply STOP to opt out.' }}",
              "type": "string"
            },
            {
              "id": "email_subject",
              "name": "email_subject",
              "value": "={{ $json.email_subject ? $json.email_subject : 'Welcome to ' + $json.practice_name + '!' }}",
              "type": "string"
            },
            {
              "id": "email_body",
              "name": "email_body",
              "value": "={{ $json.email_body ? $json.email_body : '<h2>Welcome ' + $json.payload.patientName + '!</h2><p>Thank you for choosing ' + $json.practice_name + ' for your healthcare needs.</p><p>We are committed to providing you with excellent care.</p><p>If you have any questions, please don\\'t hesitate to contact us at ' + $json.practice_phone + '.</p><p>Best regards,<br>' + $json.practice_name + ' Team</p>' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "prepare-templates",
      "name": "Prepare Templates",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1040, 240]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.sms_enabled }}",
              "value2": "={{ true }}"
            }
          ]
        }
      },
      "id": "check-sms-enabled",
      "name": "SMS Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1240, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/functions/v1/centralized-sms-gateway",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.supabaseServiceKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"practiceId\": \"{{ $json.practice_id }}\",\n  \"recipientPhone\": \"{{ $json.payload.patientPhone }}\",\n  \"messageContent\": \"{{ $json.sms_message }}\",\n  \"messageType\": \"welcome_patient\",\n  \"patientId\": \"{{ $json.payload.patient_id }}\",\n  \"metadata\": {\n    \"automation_id\": \"welcome-new-patient\",\n    \"queue_id\": \"{{ $json.queue_id }}\"\n  }\n}",
        "options": {}
      },
      "id": "send-sms",
      "name": "Send Welcome SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1440, 100]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.email_enabled }}",
              "value2": "={{ true }}"
            }
          ]
        }
      },
      "id": "check-email-enabled",
      "name": "Email Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1240, 320]
    },
    {
      "parameters": {
        "operation": "send",
        "to": "={{ $json.payload.patientEmail }}",
        "subject": "={{ $json.email_subject }}",
        "message": "={{ $json.email_body }}",
        "options": {
          "attachments": [],
          "ccList": "",
          "bccList": "",
          "replyTo": "={{ $json.practice_email || 'noreply@hpms.com' }}"
        }
      },
      "id": "send-email",
      "name": "Send Welcome Email via Gmail",
      "type": "n8n-nodes-gmail.gmail",
      "typeVersion": 2,
      "position": [1440, 380],
      "credentials": {
        "gmailOAuth2": {
          "id": "{{ $json.n8n_gmail_credential_id || '1' }}",
          "name": "Gmail OAuth2 account"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_queue?id=eq.{{ $json.queue_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.supabaseApiKey }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.supabaseServiceKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"completed\",\n  \"completed_at\": \"{{ $now.toISO() }}\",\n  \"processing_time_ms\": {{ Date.now() - new Date($json.created_at).getTime() }}\n}",
        "options": {}
      },
      "id": "update-status-completed",
      "name": "Mark as Completed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1640, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_queue?id=eq.{{ $json.queue_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.supabaseApiKey }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.supabaseServiceKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"failed\",\n  \"error_message\": \"{{ $json.error.message || 'Unknown error' }}\",\n  \"attempt_count\": {{ ($json.attempt_count || 0) + 1 }}\n}",
        "options": {}
      },
      "id": "update-status-failed",
      "name": "Mark as Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1640, 400],
      "disabled": false
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Automations",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 400]
    }
  ],
  "connections": {
    "schedule-trigger": {
      "main": [
        [
          {
            "node": "get-pending-automations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "get-pending-automations": {
      "main": [
        [
          {
            "node": "check-if-any",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-if-any": {
      "main": [
        [
          {
            "node": "split-batches",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "no-op",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "split-batches": {
      "main": [
        [
          {
            "node": "prepare-templates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "prepare-templates": {
      "main": [
        [
          {
            "node": "check-sms-enabled",
            "type": "main",
            "index": 0
          },
          {
            "node": "check-email-enabled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-sms-enabled": {
      "main": [
        [
          {
            "node": "send-sms",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check-email-enabled": {
      "main": [
        [
          {
            "node": "send-email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "send-sms": {
      "main": [
        [
          {
            "node": "update-status-completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "send-email": {
      "main": [
        [
          {
            "node": "update-status-completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "tags": [
    {
      "name": "HPMS",
      "createdAt": "2025-01-08T12:00:00.000Z"
    },
    {
      "name": "Multi-Tenant",
      "createdAt": "2025-01-08T12:00:00.000Z"
    }
  ]
}