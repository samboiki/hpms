        "jsonBody": "={{ {\n  \"status\": $json.status,\n  \"completed_at\": $now.toISO(),\n  \"error_message\": $json.error_message,\n  \"attempt_count\": $json.attempt_count,\n  \"metadata\": Object.assign({}, $json.metadata || {}, {\n    \"sms_sent\": $json.sms_sent,\n    \"email_sent\": $json.email_sent,\n    \"test_results\": $json.test_results,\n    \"processed_by\": \"n8n\"\n  })\n} }}",
        "options": {
          "timeout": 5000
        }
      },
