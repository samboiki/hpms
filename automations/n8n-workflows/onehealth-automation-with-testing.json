        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/functions/v1/centralized-email-gateway",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"practiceId\": $json.practice_id,\n  \"recipientEmail\": $json.payload.patientEmail,\n  \"subject\": $json.email_subject,\n  \"htmlContent\": $json.email_body,\n  \"emailType\": $json.automation_id,\n  \"patientId\": $json.payload.patient_id,\n  \"metadata\": {\n    \"automation_id\": $json.automation_id,\n    \"queue_id\": $json.queue_id,\n    \"gmail_failed\": true\n  }\n} }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "email_fallback",
      "name": "Email Fallback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1850, 380],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "EpJk3rG8XWa0gPp5",
          "name": "Supabase Service Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Performance Metrics Collection\nconst items = $input.all();\nconst startTime = items[0]?.json.processing_start || new Date().toISOString();\nconst endTime = new Date().toISOString();\n\n// Calculate processing time\nconst processingTimeMs = new Date(endTime) - new Date(startTime);\n\n// Analyze results\nlet smsSuccess = 0;\nlet smsFailure = 0;\nlet emailSuccess = 0;\nlet emailFailure = 0;\nlet testModeCount = 0;\n\nitems.forEach(item => {\n  if (item.json.test_mode) {\n    testModeCount++;\n  } else {\n    if (item.json.sms_sent === true) smsSuccess++;\n    if (item.json.sms_sent === false) smsFailure++;\n    if (item.json.email_sent === true) emailSuccess++;\n    if (item.json.email_sent === false) emailFailure++;\n  }\n});\n\nconst metrics = {\n  total_processed: items.length,\n  processing_time_ms: processingTimeMs,\n  avg_time_per_item: processingTimeMs / items.length,\n  sms_success: smsSuccess,\n  sms_failure: smsFailure,\n  email_success: emailSuccess,\n  email_failure: emailFailure,\n  test_mode_count: testModeCount,\n  success_rate: ((smsSuccess + emailSuccess) / ((smsSuccess + emailSuccess + smsFailure + emailFailure) || 1) * 100).toFixed(2) + '%'\n};\n\nreturn [{\n  json: {\n    metrics,\n    timestamp: endTime,\n    items: items.map(i => ({\n      queue_id: i.json.queue_id,\n      status: i.json.status,\n      test_mode: i.json.test_mode || false\n    }))\n  }\n}];"
      },
      "id": "collect_metrics",
      "name": "Collect Performance Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2050, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_performance_logs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "log_performance",
      "name": "Log Performance Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2250, 240],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Merge all results and prepare for status update\nconst items = $input.all();\nconst originalItem = items.find(item => item.json.queue_id) || items[0];\nif (!originalItem) return [];\n\n// Handle test mode\nif (originalItem.json.test_mode || originalItem.json.test_results) {\n  return [{\n    json: {\n      queue_id: originalItem.json.queue_id,\n      status: 'tested',\n      test_results: originalItem.json.test_results,\n      test_timestamp: originalItem.json.test_timestamp,\n      attempt_count: (originalItem.json.attempt_count || 0) + 1\n    }\n  }];\n}\n\n// Extract real results\nlet smsSuccess = false;\nlet emailSuccess = false;\nlet errors = [];\n\n// Check SMS result\nconst smsItem = items.find(item => item.json.success !== undefined && item.json.practice_id);\nif (smsItem) {\n  smsSuccess = smsItem.json.success === true;\n  if (!smsSuccess && smsItem.json.error) {\n    errors.push(`SMS: ${smsItem.json.error}`);\n  }\n}\n\n// Check Email result\nconst emailItem = items.find(item => (item.json.id && item.json.labelIds) || (item.json.success && item.json.message_id));\nif (emailItem) {\n  emailSuccess = true;\n}\n\n// Determine status\nlet status = 'completed';\nif (!smsSuccess && !emailSuccess) {\n  status = 'failed';\n} else if (errors.length > 0) {\n  status = 'partial';\n}\n\nreturn [{\n  json: {\n    queue_id: originalItem.json.queue_id,\n    status: status,\n    sms_sent: smsSuccess,\n    email_sent: emailSuccess,\n    error_message: errors.length > 0 ? errors.join('; ') : null,\n    attempt_count: (originalItem.json.attempt_count || 0) + 1,\n    processing_start: originalItem.json.processing_start\n  }\n}];"
      },
      "id": "merge_results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 240]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_queue?id=eq.' + $json.queue_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
