      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 160]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.email_enabled && $json.email_subject && $json.email_body && $json.payload.patientEmail }}",
              "value2": true
            }
          ]
        }
      },
      "id": "email_check",
      "name": "Email Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 320]
    },
    {
      "parameters": {
