{
  "name": "OneHealth Automation with Testing & Evaluation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "cron_trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/get_all_pending_automations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"batch_size\": 50,\n  \"max_attempts\": 3\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch_pending",
      "name": "Fetch Pending Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Test Data Validation\nconst items = $input.all();\nconst testResults = [];\n\nitems.forEach(item => {\n  const data = item.json;\n  const errors = [];\n  const warnings = [];\n  \n  // Validate required fields\n  if (!data.queue_id) errors.push('Missing queue_id');\n  if (!data.practice_id) errors.push('Missing practice_id');\n  if (!data.automation_id) errors.push('Missing automation_id');\n  if (!data.payload) errors.push('Missing payload');\n  \n  // Validate payload structure\n  if (data.payload) {\n    if (!data.payload.patient_id) warnings.push('No patient_id in payload');\n    if (!data.payload.patientEmail && data.email_enabled) errors.push('Email enabled but no patientEmail');\n    if (!data.payload.patientPhone && data.sms_enabled) errors.push('SMS enabled but no patientPhone');\n    \n    // Validate phone format\n    if (data.payload.patientPhone && !data.payload.patientPhone.match(/^\\+[0-9]{10,15}$/)) {\n      warnings.push('Phone number may not be in international format');\n    }\n    \n    // Validate email format\n    if (data.payload.patientEmail && !data.payload.patientEmail.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)) {\n      errors.push('Invalid email format');\n    }\n  }\n  \n  // Validate templates\n  if (data.sms_enabled && !data.sms_template) errors.push('SMS enabled but no template');\n  if (data.email_enabled && (!data.email_subject || !data.email_body)) errors.push('Email enabled but missing subject or body');\n  \n  // Check for test mode flag\n  const isTestMode = data.metadata?.test_mode === true;\n  \n  testResults.push({\n    ...data,\n    validation: {\n      valid: errors.length === 0,\n      errors,\n      warnings,\n      isTestMode\n    }\n  });\n});\n\nreturn testResults;"
      },
      "id": "validate_data",
      "name": "Validate & Test Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.validation.valid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "validation_check",
      "name": "Valid Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_test_logs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"queue_id\": $json.queue_id,\n  \"practice_id\": $json.practice_id,\n  \"test_type\": \"validation_failed\",\n  \"errors\": $json.validation.errors,\n  \"warnings\": $json.validation.warnings,\n  \"metadata\": {\n    \"automation_id\": $json.automation_id,\n    \"trigger_type\": $json.trigger_type,\n    \"payload\": $json.payload\n  }\n} }}",
        "options": {}
      },
      "id": "log_validation_errors",
      "name": "Log Validation Errors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 400],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.validation.isTestMode }}",
              "value2": true
            }
          ]
        }
      },
      "id": "test_mode_check",
      "name": "Test Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Simulate sending without actually sending\nconst item = $input.item.json;\nconst simulatedResults = [];\n\n// Simulate SMS\nif (item.sms_enabled) {\n  simulatedResults.push({\n    type: 'sms',\n    to: item.payload.patientPhone,\n    content: item.sms_template,\n    simulated: true,\n    success: true,\n    message: 'SMS would be sent successfully'\n  });\n}\n\n// Simulate Email\nif (item.email_enabled) {\n  simulatedResults.push({\n    type: 'email',\n    to: item.payload.patientEmail,\n    subject: item.email_subject,\n    body: item.email_body,\n    simulated: true,\n    success: true,\n    message: 'Email would be sent successfully'\n  });\n}\n\nreturn [{\n  json: {\n    ...item,\n    test_results: simulatedResults,\n    test_mode: true,\n    test_timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "simulate_sending",
      "name": "Simulate Sending (Test)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 100]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
