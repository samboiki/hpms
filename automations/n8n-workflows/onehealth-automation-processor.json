        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"practiceId\": \"{{ $json.practice_id }}\",\n  \"recipientEmail\": \"{{ $json.payload.patientEmail }}\",\n  \"subject\": \"{{ $json.email_subject }}\",\n  \"htmlContent\": \"{{ $json.email_body }}\",\n  \"emailType\": \"welcome_patient\",\n  \"patientId\": \"{{ $json.payload.patient_id }}\",\n  \"metadata\": {\n    \"automation_id\": \"welcome-new-patient\",\n    \"queue_id\": \"{{ $json.queue_id }}\",\n    \"fallback_reason\": \"Gmail OAuth failed\"\n  }\n}",
        "options": {}
      },
      "id": "email-fallback",
      "name": "Email Fallback (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1440, 500]
    },
    {
      "parameters": {},
      "id": "no-op",
      "name": "No Automations",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [840, 400]
    }
  ],
