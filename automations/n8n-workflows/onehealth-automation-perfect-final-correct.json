      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 800],
      "notesInFlow": true,
      "notes": "Timing is handled by the Supabase function.\nprocess_all_pending_automations only returns\nautomations that are due based on their\nscheduled_for timestamp."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/process_all_pending_automations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": false,
        "options": {
          "timeout": 30000
        }
      },
      "id": "get_pending",
      "name": "🔍 Get All Pending Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 800],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse response and prepare data\nconst items = $input.all();\nlet automations = [];\n\n// Extract automations array\nif (items && items.length > 0) {\n  const firstItem = items[0].json;\n  if (Array.isArray(firstItem)) {\n    automations = firstItem;\n  } else if (firstItem.data && Array.isArray(firstItem.data)) {\n    automations = firstItem.data;\n  }\n}\n\nconsole.log(`Found ${automations.length} pending automations`);\n\n// Map practice IDs to Gmail credential IDs\nconst practiceCredentialMap = {\n  'ffed1160-00ec-4c4f-8810-913a24348d90': 'uA0l39VD4cMHN9cC', // NewCharm\n  'onehealth_practice_id': 'HrTrOqI74H5m5dyg', // OneHealth - replace with actual practice ID\n  // Add more practice mappings here as needed\n};\n\n// Split SMS and Email for parallel processing\nconst smsAutomations = [];\nconst emailsByPractice = {};\n\nautomations.forEach(automation => {\n  if (automation.type === 'SMS') {\n    smsAutomations.push(automation);\n  } else if (automation.type === 'EMAIL') {\n    const practiceId = automation.practice_id;\n    if (!emailsByPractice[practiceId]) {\n      emailsByPractice[practiceId] = {\n        practice_id: practiceId,\n        practice_name: automation.practice_name,\n        gmail_credential_id: practiceCredentialMap[practiceId] || null,\n        automations: []\n      };\n    }\n    emailsByPractice[practiceId].automations.push(automation);\n  }\n});\n\n// Create outputs\nconst outputs = [];\n\n// Add SMS batch if any\nif (smsAutomations.length > 0) {\n  outputs.push({\n    json: {\n      type: 'SMS_BATCH',\n      automations: smsAutomations\n    }\n  });\n}\n\n// Add email groups by practice\nObject.values(emailsByPractice).forEach(practiceEmails => {\n  outputs.push({\n    json: {\n      type: 'EMAIL_PRACTICE',\n      ...practiceEmails\n    }\n  });\n});\n\nconsole.log(`Processing ${smsAutomations.length} SMS and ${Object.keys(emailsByPractice).length} practice email groups`);\n\nreturn outputs.length > 0 ? outputs : [{ json: { type: 'NONE' } }];"
      },
      "id": "prepare_data",
      "name": "📊 Prepare SMS & Email Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [650, 800]
    },
