      "parameters": {
        "jsCode": "// Handle emails from unknown practices\nconst practiceData = $json;\nconst failedEmails = [];\n\nconsole.log(`Unknown practice ${practiceData.practice_name} (${practiceData.practice_id}) - no Gmail credentials`);\n\n// Mark all emails as failed\npracticeData.automations.forEach(automation => {\n  failedEmails.push({\n    json: {\n      id: automation.id,\n      type: 'EMAIL',\n      status: 'failed',\n      error_message: 'No Gmail credentials configured for this practice',\n      practice_id: practiceData.practice_id\n    }\n  });\n});\n\nreturn failedEmails;"
