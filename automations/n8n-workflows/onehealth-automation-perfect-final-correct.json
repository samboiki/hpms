        "jsCode": "// Prepare status updates\nconst allItems = $input.all();\nconst updates = [];\n\nallItems.forEach(item => {\n  if (item.json.id) {\n    updates.push({\n      id: item.json.id,\n      status: item.json.status || 'completed',\n      processed_at: new Date().toISOString(),\n      error_message: item.json.error_message || null\n    });\n  }\n});\n\nconsole.log(`Updating ${updates.length} automation statuses`);\nreturn updates.map(update => ({ json: update }));"
      },
