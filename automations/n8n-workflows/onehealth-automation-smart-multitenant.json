    {
      "parameters": {
        "jsCode": "// Process automations for Dr. Smith's Clinic\nconst automations = $json.automations || [];\nconst practiceId = $json.practice_id;\nconst practiceName = $json.practice_name;\n\n// Split into SMS and Email groups\nconst smsAutomations = [];\nconst emailAutomations = [];\n\nautomations.forEach(automation => {\n  if (automation.type === 'SMS') {\n    smsAutomations.push(automation);\n  } else if (automation.type === 'EMAIL') {\n    emailAutomations.push(automation);\n  }\n});\n\n// Return both groups for parallel processing\nreturn [\n  {\n    json: {\n      practice_id: practiceId,\n      practice_name: practiceName,\n      type: 'SMS',\n      automations: smsAutomations\n    }\n  },\n  {\n    json: {\n      practice_id: practiceId,\n      practice_name: practiceName,\n      type: 'EMAIL',\n      gmail_credentials: $json.gmail_credentials,\n      automations: emailAutomations\n    }\n  }\n];"
      },
      "id": "practice_1_processor",
      "name": "📊 Process Dr. Smith's Automations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1550, 200]
    },
