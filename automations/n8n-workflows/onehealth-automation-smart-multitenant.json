      "parameters": {
        "jsCode": "// Route to correct practice-specific nodes based on practice_id\nconst practiceId = $json.practice_id;\nconst practiceName = $json.practice_name;\n\n// Map practice IDs to their node outputs\nconst practiceRoutes = {\n  'practice_1_id': 0,  // Dr. Smith's Clinic\n  'practice_2_id': 1,  // City Medical Center\n  'practice_3_id': 2,  // Health Plus Practice\n  'practice_4_id': 3,  // Family Care Clinic\n  'practice_5_id': 4   // Wellness Center\n};\n\n// Determine route\nconst routeIndex = practiceRoutes[practiceId] !== undefined ? practiceRoutes[practiceId] : 5; // Default route\n\n// Add routing info\n$json.route_index = routeIndex;\n$json.route_name = practiceName;\n\nreturn $json;"
      },
      "id": "route_to_practice",
