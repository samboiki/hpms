        "values": {
          "boolean": [
            {
              "name": "is_sms",
              "value": "={{ $json.type === 'SMS' }}"
            }
          ]
        }
      },
      "id": "practice_1_splitter",
      "name": "Split SMS/Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
