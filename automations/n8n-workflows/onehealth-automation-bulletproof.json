{
  "name": "OneHealth Automation Engine - Bulletproof",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "cron_trigger",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/get_pending_automations_for_n8n",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": false,
        "options": {
          "timeout": 30000
        }
      },
      "id": "get_pending_json",
      "name": "Get Pending (JSON)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Parse the JSON response and prepare items\nconst items = $input.all();\nlet automations = [];\n\ntry {\n  // Handle different response formats\n  if (items && items.length > 0) {\n    const firstItem = items[0].json;\n    \n    // Check if we got the array directly or wrapped\n    if (Array.isArray(firstItem)) {\n      automations = firstItem;\n    } else if (firstItem.data && Array.isArray(firstItem.data)) {\n      automations = firstItem.data;\n    } else if (firstItem && typeof firstItem === 'object') {\n      // Single object response\n      automations = [firstItem];\n    }\n  }\n} catch (error) {\n  console.error('Error parsing response:', error);\n}\n\n// Return empty array if no automations\nif (!automations || automations.length === 0) {\n  return [{\n    json: {\n      hasData: false,\n      message: 'No pending automations found',\n      count: 0\n    }\n  }];\n}\n\n// Process each automation\nreturn automations.map(item => ({\n  json: {\n    hasData: true,\n    ...item,\n    // Ensure phone is in international format\n    processedPhone: item.payload?.patientPhone?.startsWith('+') \n      ? item.payload.patientPhone \n      : '+264' + (item.payload?.patientPhone?.startsWith('0') \n        ? item.payload.patientPhone.substring(1) \n        : item.payload?.patientPhone || '')\n  }\n}));"
      },
      "id": "parse_response",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasData }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check_has_data",
      "name": "Has Data?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "status",
              "value": "No pending automations"
            }
          ],
          "number": [
            {
              "name": "count",
              "value": 0
            }
          ]
        },
        "options": {}
      },
      "id": "no_data_output",
      "name": "No Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1050, 400]
    },
    {
      "parameters": {
        "jsCode": "// Process templates with comprehensive error handling\nconst items = $input.all();\nconst processedItems = [];\n\nitems.forEach(item => {\n  const data = item.json;\n  const errors = [];\n  const warnings = [];\n  \n  // Validate required fields\n  if (!data.queue_id) errors.push('Missing queue_id');\n  if (!data.practice_id) errors.push('Missing practice_id');\n  if (!data.automation_id) errors.push('Missing automation_id');\n  \n  // Check payload\n  const payload = data.payload || {};\n  if (!payload.patientName) warnings.push('Missing patient name');\n  if (!payload.patientEmail && data.email_enabled) warnings.push('Email enabled but no patient email');\n  if (!payload.patientPhone && data.sms_enabled) warnings.push('SMS enabled but no patient phone');\n  \n  // Process template variables\n  const templateVars = {\n    ...payload,\n    practiceName: data.practice_name || payload.practiceName || '',\n    practicePhone: data.practice_phone || payload.practicePhone || '',\n    practiceEmail: data.practice_email || payload.practiceEmail || '',\n    patientName: payload.patientName || 'Patient',\n    patientPhone: data.processedPhone || payload.patientPhone || '',\n    patientEmail: payload.patientEmail || ''\n  };\n  \n  // Function to replace template variables\n  const processTemplate = (template) => {\n    if (!template) return '';\n    let processed = template;\n    Object.keys(templateVars).forEach(key => {\n      const regex = new RegExp(`{{\\\\s*${key}\\\\s*}}`, 'g');\n      processed = processed.replace(regex, templateVars[key] || '');\n    });\n    return processed;\n  };\n  \n  processedItems.push({\n    ...data,\n    validation: {\n      valid: errors.length === 0,\n      errors,\n      warnings\n    },\n    processed: {\n      sms_template: processTemplate(data.sms_template),\n      email_subject: processTemplate(data.email_subject),\n      email_body: processTemplate(data.email_body),\n      recipient_phone: templateVars.patientPhone,\n      recipient_email: templateVars.patientEmail\n    }\n  });\n});\n\nreturn processedItems;"
      },
      "id": "process_templates",
      "name": "Process Templates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.validation.valid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "is_valid",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/fail_automation",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"p_queue_id\": $json.queue_id,\n  \"p_error_message\": \"Validation failed: \" + $json.validation.errors.join(', '),\n  \"p_retry\": false\n} }}",
        "options": {}
      },
      "id": "fail_invalid",
      "name": "Fail Invalid",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 300],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.sms_enabled }}",
              "value2": true
            },
            {
              "value1": "={{ $json.processed.recipient_phone !== '' }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check_sms",
      "name": "SMS Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1450, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/functions/v1/centralized-sms-gateway",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.serviceKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"practiceId\": $json.practice_id,\n  \"recipientPhone\": $json.processed.recipient_phone,\n  \"messageContent\": $json.processed.sms_template,\n  \"messageType\": $json.automation_id,\n  \"patientId\": $json.payload?.patient_id,\n  \"metadata\": {\n    \"automation_queue_id\": $json.queue_id,\n    \"test_mode\": $json.test_mode || false\n  }\n} }}",
        "options": {}
      },
      "id": "send_sms",
      "name": "Send SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1650, 50],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.email_enabled }}",
              "value2": true
            },
            {
              "value1": "={{ $json.processed.recipient_email !== '' }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check_email",
      "name": "Email Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1850, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/functions/v1/centralized-email-gateway",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.serviceKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"practiceId\": $json.practice_id,\n  \"recipientEmail\": $json.processed.recipient_email,\n  \"subject\": $json.processed.email_subject,\n  \"htmlContent\": $json.processed.email_body,\n  \"emailType\": $json.automation_id,\n  \"patientId\": $json.payload?.patient_id,\n  \"metadata\": {\n    \"automation_queue_id\": $json.queue_id,\n    \"test_mode\": $json.test_mode || false\n  }\n} }}",
        "options": {}
      },
      "id": "send_email",
      "name": "Send Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2050, 50],
      "continueOnFail": true,
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Collect all results and determine success\nconst originalData = $node[\"Process Templates\"].json;\nconst allInputs = $input.all();\n\n// Check what was sent\nlet smsResult = null;\nlet emailResult = null;\n\n// Get results from different paths\nallInputs.forEach(input => {\n  if (input.json.message_id) {\n    // This is SMS result\n    smsResult = input.json;\n  } else if (input.json.email_id) {\n    // This is email result\n    emailResult = input.json;\n  }\n});\n\n// Determine overall success\nconst smsSuccess = !originalData.sms_enabled || \n  !originalData.processed.recipient_phone || \n  (smsResult && smsResult.success !== false);\n  \nconst emailSuccess = !originalData.email_enabled || \n  !originalData.processed.recipient_email || \n  (emailResult && emailResult.success !== false);\n\nconst overallSuccess = smsSuccess && emailSuccess;\n\nreturn [{\n  queue_id: originalData.queue_id,\n  success: overallSuccess,\n  sms_sent: originalData.sms_enabled ? smsSuccess : null,\n  email_sent: originalData.email_enabled ? emailSuccess : null,\n  sms_result: smsResult,\n  email_result: emailResult,\n  error_message: overallSuccess ? null : 'Failed to send some communications'\n}];"
      },
      "id": "merge_results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2250, 100]
    },
