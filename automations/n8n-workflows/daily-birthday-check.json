        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "queue-birthdays",
      "name": "🎂 Queue Birthday Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        200,
        200
      ],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/mark_birthday_check_complete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "mark-complete",
      "name": "✅ Mark Check Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        200
      ],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Log the results\nconst birthdays = $('🎂 Queue Birthday Automations').first().json;\n\nconsole.log('Birthday check results:', birthdays);\n\nreturn [{\n  json: {\n    message: 'Birthday check completed',\n    results: birthdays,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "log-results",
      "name": "📊 Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        600,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Already ran today\nreturn [{\n  json: {\n    message: 'Birthday check already ran today',\n    skipped: true,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "already-ran",
      "name": "⏭️ Already Ran Today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "content": "## 🎂 Daily Birthday Automation Checker\n\nThis workflow runs once daily at 8 AM to:\n1. Check if birthday check already ran today\n2. Find all patients with birthdays today\n3. Create automation_queue entries for practices with birthday automation enabled\n4. Mark the check as complete to prevent duplicate runs\n\nThe birthday automations will be picked up by the main automation processing workflow.",
        "height": 250,
        "width": 1200,
        "color": 4
      },
      "id": "workflow-note",
      "name": "Workflow Description",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -50
      ]
    }
