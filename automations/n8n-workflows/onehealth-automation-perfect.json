    {
      "parameters": {
        "jsCode": "// Determine if automation was successful\nconst data = $input.first().json;\n\n// Check SMS result\nlet smsSuccess = true;\nlet smsError = null;\nif (data.should_send_sms) {\n  // Check for SMS gateway response\n  if (data.error || data.statusCode >= 400) {\n    smsSuccess = false;\n    smsError = data.error || data.message || 'SMS send failed';\n  }\n}\n\n// Check email result  \nlet emailSuccess = true;\nlet emailError = null;\nif (data.should_send_email) {\n  // Check for email gateway response\n  if (data.error || data.statusCode >= 400) {\n    emailSuccess = false;\n    emailError = data.error || data.message || 'Email send failed';\n  }\n}\n\n// Overall success if all enabled channels succeeded\nconst overallSuccess = smsSuccess && emailSuccess;\n\n// Build error message\nlet errorMessage = null;\nif (!overallSuccess) {\n  const errors = [];\n  if (smsError) errors.push(`SMS: ${smsError}`);\n  if (emailError) errors.push(`Email: ${emailError}`);\n  errorMessage = errors.join('; ');\n}\n\nreturn {\n  json: {\n    queue_id: data.queue_id,\n    success: overallSuccess,\n    error_message: errorMessage,\n    sms_sent: data.should_send_sms ? smsSuccess : null,\n    email_sent: data.should_send_email ? emailSuccess : null,\n    details: {\n      sms: smsError,\n      email: emailError\n    }\n  }\n};"
      },
      "id": "check_result",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
