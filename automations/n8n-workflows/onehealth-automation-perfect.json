    {
      "parameters": {
        "jsCode": "// Process templates and prepare for sending\nconst data = $input.first().json;\n\n// Get all template variables\nconst vars = {\n  patientName: data.payload?.patientName || 'Patient',\n  patientPhone: data.formatted_phone || '',\n  patientEmail: data.payload?.patientEmail || '',\n  practiceName: data.practice_name || data.payload?.practiceName || '',\n  practicePhone: data.practice_phone || data.payload?.practicePhone || '',\n  practiceEmail: data.practice_email || data.payload?.practiceEmail || '',\n  appointmentDate: data.payload?.appointmentDate || '',\n  appointmentTime: data.payload?.appointmentTime || '',\n  doctorName: data.payload?.doctorName || ''\n};\n\n// Function to replace template variables\nfunction processTemplate(template) {\n  if (!template) return '';\n  let processed = template;\n  for (const [key, value] of Object.entries(vars)) {\n    const regex = new RegExp(`{{\\\\s*${key}\\\\s*}}`, 'g');\n    processed = processed.replace(regex, value);\n  }\n  return processed;\n}\n\n// Process all templates\nreturn {\n  json: {\n    ...data,\n    processed: {\n      sms_content: processTemplate(data.sms_template),\n      email_subject: processTemplate(data.email_subject),\n      email_body: processTemplate(data.email_body),\n      recipient_phone: vars.patientPhone,\n      recipient_email: vars.patientEmail\n    },\n    template_vars: vars\n  }\n};"
      },
      "id": "process_templates",
      "name": "Process Templates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 200]
