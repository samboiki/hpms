      "id": "get_pending",
      "name": "Get Pending (Read Only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Parse and prepare automations\nconst response = $input.first()?.json;\nlet automations = [];\n\n// Handle different response formats\nif (Array.isArray(response)) {\n  automations = response;\n} else if (response?.data && Array.isArray(response.data)) {\n  automations = response.data;\n} else if (response && typeof response === 'object' && !Array.isArray(response)) {\n  // Single object, wrap in array\n  automations = [response];\n}\n\n// Filter out any invalid entries\nautomations = automations.filter(item => \n  item && \n  item.queue_id && \n  item.practice_id &&\n  item.automation_id\n);\n\nif (automations.length === 0) {\n  return [{\n    json: {\n      hasData: false,\n      message: 'No pending automations found',\n      count: 0\n    }\n  }];\n}\n\n// Return each automation as a separate item for processing\nreturn automations.map(item => ({\n  json: {\n    hasData: true,\n    ...item,\n    // Ensure phone is properly formatted\n    formatted_phone: formatPhone(item.payload?.patientPhone),\n    // Add processing flags\n    should_send_sms: item.sms_enabled && item.sms_template && formatPhone(item.payload?.patientPhone),\n    should_send_email: item.email_enabled && item.email_subject && item.email_body && item.payload?.patientEmail\n  }\n}));\n\n// Helper function to format phone numbers\nfunction formatPhone(phone) {\n  if (!phone) return '';\n  phone = phone.toString().trim();\n  if (phone.startsWith('+')) return phone;\n  if (phone.startsWith('0')) {\n    return '+264' + phone.substring(1);\n  }\n  return '+264' + phone;\n}"
      },
      "id": "parse_automations",
      "name": "Parse Automations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
