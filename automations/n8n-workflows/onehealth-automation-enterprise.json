      "id": "get_pending_automations",
      "name": "Get Pending Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 340],
      "credentials": {
        "supabaseApi": {
          "id": "czZG3bwVoyN4WUIu",
          "name": "Supabase API"
        }
      },
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Parse the response and prepare automations\nconst input = $input.first();\nlet automations = [];\n\n// Log for debugging\nconsole.log('Raw input:', JSON.stringify(input, null, 2));\n\n// Handle different response formats\nif (input && input.json) {\n  const response = input.json;\n  \n  if (Array.isArray(response)) {\n    automations = response;\n  } else if (response.data && Array.isArray(response.data)) {\n    automations = response.data;\n  } else if (typeof response === 'object') {\n    // Check if it's a single automation object\n    if (response.queue_id) {\n      automations = [response];\n    }\n  }\n}\n\n// Filter valid automations\nautomations = automations.filter(item => \n  item && \n  item.queue_id && \n  item.practice_id &&\n  item.automation_id &&\n  item.payload\n);\n\n// Log what we found\nconsole.log(`Found ${automations.length} valid automations`);\n\nif (automations.length === 0) {\n  return [{\n    json: {\n      hasData: false,\n      message: 'No pending automations found',\n      count: 0,\n      timestamp: new Date().toISOString()\n    }\n  }];\n}\n\n// Process each automation\nreturn automations.map(automation => {\n  // Format phone number\n  let formattedPhone = '';\n  if (automation.payload?.patientPhone) {\n    const phone = automation.payload.patientPhone.toString().trim();\n    if (phone.startsWith('+')) {\n      formattedPhone = phone;\n    } else if (phone.startsWith('0')) {\n      formattedPhone = '+264' + phone.substring(1);\n    } else {\n      formattedPhone = '+264' + phone;\n    }\n  }\n  \n  return {\n    json: {\n      hasData: true,\n      ...automation,\n      // Add processed fields\n      processed: {\n        phone: formattedPhone,\n        email: automation.payload?.patientEmail || '',\n        shouldSendSms: automation.sms_enabled && formattedPhone && automation.sms_template,\n        shouldSendEmail: automation.email_enabled && automation.payload?.patientEmail && automation.email_subject\n      },\n      // Process templates\n      templates: {\n        sms: processTemplate(automation.sms_template || '', automation),\n        emailSubject: processTemplate(automation.email_subject || '', automation),\n        emailBody: processTemplate(automation.email_body || '', automation)\n      }\n    }\n  };\n});\n\n// Helper function to process templates\nfunction processTemplate(template, automation) {\n  if (!template) return '';\n  \n  const vars = {\n    patientName: automation.payload?.patientName || 'Patient',\n    patientPhone: automation.payload?.patientPhone || '',\n    patientEmail: automation.payload?.patientEmail || '',\n    practiceName: automation.practice_name || automation.payload?.practiceName || '',\n    practicePhone: automation.practice_phone || automation.payload?.practicePhone || '',\n    practiceEmail: automation.practice_email || automation.payload?.practiceEmail || '',\n    appointmentDate: automation.payload?.appointmentDate || '',\n    appointmentTime: automation.payload?.appointmentTime || '',\n    doctorName: automation.payload?.doctorName || ''\n  };\n  \n  let processed = template;\n  Object.keys(vars).forEach(key => {\n    const regex = new RegExp(`{{\\\\s*${key}\\\\s*}}`, 'g');\n    processed = processed.replace(regex, vars[key]);\n  });\n  \n  return processed;\n}"
      },
