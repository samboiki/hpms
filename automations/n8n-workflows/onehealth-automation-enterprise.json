    {
      "parameters": {
        "jsCode": "// Evaluate the results and determine success\nconst input = $input.first().json;\n\n// Extract results\nlet smsSuccess = false;\nlet emailSuccess = false;\nlet smsError = null;\nlet emailError = null;\nlet gmailMessageId = null;\n\n// Check SMS result\nif (input.processed?.shouldSendSms) {\n  if (input.sms_sent === false) {\n    smsError = input.sms_error || 'SMS send failed';\n  } else if (input.message_id) {\n    smsSuccess = true;\n  } else if (input.error) {\n    smsError = input.error;\n  } else {\n    // Check HTTP status\n    const statusCode = input.statusCode || input.responseCode;\n    if (statusCode && statusCode >= 200 && statusCode < 300) {\n      smsSuccess = true;\n    } else {\n      smsError = `SMS failed with status ${statusCode}`;\n    }\n  }\n}\n\n// Check email result\nif (input.processed?.shouldSendEmail) {\n  if (input.email_sent === false) {\n    emailError = input.email_error || 'Email send failed';\n  } else if (input.id && input.threadId) {\n    // Gmail response includes message ID and thread ID\n    emailSuccess = true;\n    gmailMessageId = input.id;\n  } else if (input.error) {\n    emailError = input.error;\n  }\n}\n\n// Determine overall success\nconst overallSuccess = \n  (!input.processed?.shouldSendSms || smsSuccess) && \n  (!input.processed?.shouldSendEmail || emailSuccess);\n\n// Build detailed result\nreturn [{\n  json: {\n    queue_id: input.queue_id,\n    success: overallSuccess,\n    results: {\n      sms: {\n        enabled: input.processed?.shouldSendSms || false,\n        sent: smsSuccess,\n        error: smsError\n      },\n      email: {\n        enabled: input.processed?.shouldSendEmail || false,\n        sent: emailSuccess,\n        error: emailError,\n        gmailMessageId: gmailMessageId\n      }\n    },\n    automation: {\n      id: input.automation_id,\n      type: input.trigger_type,\n      patient: input.payload?.patientName\n    }\n  }\n}];"
      },
