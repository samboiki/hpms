        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"p_queue_id\": $json.queue_id,\n  \"p_success_message\": \"Successfully processed automation\"\n} }}",
        "options": {}
      },
      "id": "mark_complete",
