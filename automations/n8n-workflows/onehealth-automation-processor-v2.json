{
  "name": "OneHealth Automation Processor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "91e6b9e4-3a3e-4b08-a5ed-ed3e5c1b0b8f",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/rpc/get_pending_welcome_automations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"batch_size\": 10 }",
        "options": {}
      },
      "id": "c9f6b9e4-5a4e-4c19-8d3f-ed4e5c2b1b9f",
      "name": "Get Pending Automations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [600, 300],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "d8e5c8f5-6b5f-5d2a-9e4f-fe5f6d3c2c0f",
      "name": "Check If Any",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "sms_message",
              "stringValue": "={{ $json.sms_template || 'Welcome to ' + $json.practice_name + ', ' + $json.payload.patientName + '! We look forward to caring for you.' }}"
            },
            {
              "name": "email_subject",
              "stringValue": "={{ $json.email_subject || 'Welcome to ' + $json.practice_name + '!' }}"
            },
            {
              "name": "email_body",
              "stringValue": "={{ $json.email_body || '<h2>Welcome ' + $json.payload.patientName + '!</h2><p>Thank you for choosing ' + $json.practice_name + '.</p>' }}"
            }
          ]
        },
        "include": "all",
        "options": {}
      },
      "id": "e9f6d0f6-7c6f-6e3b-af5f-0f6f7e4d3d1f",
      "name": "Prepare Messages",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1000, 240]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.payload.patientEmail }}",
        "subject": "={{ $json.email_subject }}",
        "messageType": "html",
        "message": "={{ $json.email_body }}",
        "options": {}
      },
      "id": "f0a7e1a7-8d7a-7f4c-b06a-1a7a8f5e4e2a",
      "name": "Send Gmail",
      "type": "n8n-nodes-gmail.gmail",
      "typeVersion": 2.1,
      "position": [1200, 160],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Gmail OAuth2"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jjxlfunlbyayxwvlpgwt.supabase.co/functions/v1/centralized-sms-gateway",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.supabaseServiceKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"practiceId\": \"{{ $json.practice_id }}\",\n  \"recipientPhone\": \"{{ $json.payload.patientPhone }}\",\n  \"messageContent\": \"{{ $json.sms_message }}\",\n  \"messageType\": \"welcome_patient\",\n  \"patientId\": \"{{ $json.payload.patient_id }}\"\n}",
        "options": {}
      },
      "id": "a1b8f2b8-9e8b-8a5d-c17b-2b8b9a6f5f3b",
      "name": "Send SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 320],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Supabase Service Key"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://jjxlfunlbyayxwvlpgwt.supabase.co/rest/v1/automation_queue?id=eq.' + $json.queue_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"completed\",\n  \"completed_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "b2c9a3c9-0f9c-9b6e-d28c-3c9c0b7a6a4c",
      "name": "Mark Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 240],
      "credentials": {
        "supabaseApi": {
          "id": "1",
          "name": "Supabase API"
        }
      }
    },
    {
      "parameters": {},
      "id": "c3d0b4d0-1a0d-0c7f-e39d-4d0d1c8b7b5d",
      "name": "No Items",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Get Pending Automations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Automations": {
      "main": [
        [
          {
            "node": "Check If Any",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Any": {
      "main": [
        [
          {
            "node": "Prepare Messages",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Messages": {
      "main": [
        [
          {
            "node": "Send Gmail",
            "type": "main",
            "index": 0
          },
          {
            "node": "Send SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Gmail": {
      "main": [
        [
          {
            "node": "Mark Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send SMS": {
      "main": [
        [
          {
            "node": "Mark Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "versionId": "01234567-89ab-cdef-0123-456789abcdef",
  "id": "99",
  "meta": {
    "instanceId": "8a47b83b4479b11330fdf21291c70e04db23108b106cce4a5b43b4dd5baadd96"
  },
  "tags": [
    {
      "name": "OneHealth",
      "createdAt": "2025-01-08T12:00:00.000Z",
      "id": "1"
    }
  ]
}