# Browser settings (copy to .env). Everything here ends up in the public JavaScript, so never put a secret key
# in a VITE_ variable: secrets belong in Supabase > Edge Functions > Secrets (list below).

# Supabase Configuration (the anon/publishable key is public by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# AI reading of lab reports and AI patient search: set to true once GEMINI_API_KEY is set in Supabase
VITE_AI_ASSIST_ENABLED=false

# n8n webhook URL for the older AI patient search (not a secret)
VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/onehealth-search

# Edge function secrets (set in Supabase, never here):
#   SMS_PORTAL_CLIENT_ID, SMS_PORTAL_API_SECRET  - SMSPortal, used by centralized-sms-gateway
#   SMS_REPLY_WEBHOOK_KEY                        - shared secret in the SMSPortal reply webhook URL (sms-reply-webhook)
#   RESEND_API_KEY, SENDER_EMAIL                 - Resend, used by centralized-email-gateway
#   GEMINI_API_KEY (optional GEMINI_MODEL)       - Gemini, used by ai-assist
