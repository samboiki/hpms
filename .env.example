# Resend API Configuration
VITE_RESEND_API_KEY=your_resend_api_key_here

# Add your Resend API key from https://resend.com/api-keys
# The key should start with "re_"

# n8n Webhook Configuration
VITE_N8N_WEBHOOK_URL=https://onehealthsystems.app.n8n.cloud/webhook/onehealth-search
VITE_N8N_API_KEY=your_n8n_api_key_here

# n8n webhook URL for AI patient search
# Using n8n cloud instance: https://onehealthsystems.app.n8n.cloud/webhook/onehealth-search
# For local n8n, use: http://localhost:5678/webhook/onehealth-search (if running locally)
# API key is optional but recommended for security